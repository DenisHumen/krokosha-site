---
// The left rail of wide screens: the socials as round icons, a thin line with a dot that follows the
// scroll (scripts/home.ts) and, once somebody finds an easter egg, the «eggs 2/8» counter that opens
// the panel of achievements.
import type { SitePageData } from '../lib/page-data.ts';
import Icon from './Icon.astro';

interface Props {
  data: SitePageData;
}

const { profile, site } = Astro.props.data;
const external = (url: string) => url.startsWith('https://');
---

<aside class="rail" aria-label={site.ui.socials}>
  <ul data-slot="socials">
    {profile.socials.map((social) => (
      <li data-component="social-button">
        <a
          href={social.url}
          data-field="url"
          data-social={social.id}
          data-track={`social-${social.id}`}
          rel={external(social.url) ? 'me noopener' : undefined}
          aria-label={social.label}
          title={social.label}
        >
          <Icon name={social.id} />
        </a>
      </li>
    ))}
  </ul>
  <i class="rail-line" aria-hidden="true">
    <b data-rail-dot></b>
  </i>
  {/* Shown by scripts/home.ts once an egg is found; opens the panel of achievements. */}
  <button
    class="rail-eggs mono"
    type="button"
    aria-haspopup="dialog"
    data-eggs-caption
    hidden
  ></button>
</aside>

<style>
  .rail {
    position: fixed;
    left: 0;
    top: var(--header-h);
    bottom: 0;
    width: var(--rail-w);
    z-index: var(--z-rail);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 0;
    border-right: 1px solid var(--line);
    background: var(--bg);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid transparent;
    border-radius: 50%;
    color: var(--fg-2);
    transition: all var(--dur-1);
  }

  a:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  .rail-line {
    position: relative;
    flex: 1;
    width: 1px;
    overflow: hidden;
    background: var(--line);
  }

  .rail-line b {
    position: absolute;
    left: -2px;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .rail-eggs {
    writing-mode: vertical-rl;
    padding: 0.4rem 0.2rem;
    border: 0;
    border-radius: var(--radius-s);
    background: none;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--dur-1);
  }

  .rail-eggs:hover {
    color: var(--accent);
  }

  .rail-eggs[hidden] {
    display: none;
  }

  @media (max-width: 900px) {
    .rail {
      display: none;
    }
  }
</style>

---
// Only numbers that come from data — no invented metrics (brief A3).
import type { SitePageData } from '../lib/page-data.ts';

interface Props {
  data: SitePageData;
}

const { profile, projects, site } = Astro.props.data;
---

<section class="section" id="stats" data-section="stats">
  <h2 data-slot="site.ui.headings.stats">{site.ui.headings.stats}</h2>
  <dl class="stats">
    <div>
      <dt data-slot="site.stats.experience">{site.stats.experience}</dt>
      <dd class="mono" data-slot="profile.experience_years">
        {profile.experience_years}
      </dd>
    </div>
    <div>
      <dt data-slot="site.stats.public_projects">{site.stats.public_projects}</dt>
      <dd class="mono" data-slot="projects.public.count">
        {projects.public.length}
      </dd>
    </div>
  </dl>
</section>

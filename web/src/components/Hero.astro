---
// The first screen (design: HERO). 260vh tall, its content sticks while the page scrolls: the two
// glyph hands of <kro-hands> (design/components/hero/hands.js) approach each other, and when the
// fingers meet the «link up» caption lights up. The scroll drives it all (scripts/home.ts); without
// a script the headline, the calls to action and the person are simply there.
import type { SitePageData } from '../lib/page-data.ts';
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';

interface Props {
  data: SitePageData;
}

const { data } = Astro.props;
const { profile, site } = data;
const { hero } = site;
const eggs = site.flags.easter_eggs;
const reboot = eggs.enabled && eggs.avatar_reboot;
const primary = profile.socials.filter((social) => social.primary === true);
const ctaLabels: Record<string, string> = { telegram: hero.cta.telegram, email: hero.cta.email };
const external = (url: string) => url.startsWith('https://');
---

<section class="hero" id="hero" data-section="hero" data-hero>
  <div class="stage">
    <kro-hands class="hands" layout="h" aria-hidden="true" data-hands></kro-hands>
    <div class="text" data-hero-text>
      <div class="inner">
        <h1>
          <span class="line-muted" data-slot="site.hero.headline.muted">
            {hero.headline.muted}
          </span>
          <span class="line-strong" data-slot="site.hero.headline.strong">
            {hero.headline.strong}
          </span>
        </h1>
        <p class="lead" data-slot="site.hero.lead">
          {hero.lead}
        </p>
        <div class="actions">
          <ul class="ctas" data-slot="socials">
            {primary.map((social) => (
              <li data-component="social-button">
                <a
                  class:list={['pill', 'cta', social.id === 'telegram' ? 'cta-main' : 'cta-line']}
                  href={social.url}
                  data-field="url"
                  data-social={social.id}
                  data-track={`cta-${social.id}`}
                  rel={external(social.url) ? 'me noopener' : undefined}
                >
                  <Icon name={social.id} size={16} stroke={1.7} />
                  <span data-field="label">{ctaLabels[social.id] ?? social.label}</span>
                </a>
              </li>
            ))}
          </ul>
          <a
            class="discuss"
            href="#contacts"
            data-track="cta-discuss"
            data-slot="site.hero.cta.discuss"
          >
            {hero.cta.discuss}{' '}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
        <div class="person">
          {reboot ? (
            /* Five clicks «reboot» the avatar like a server (an easter egg, flag avatar_reboot). */
            <button class="avatar" type="button" aria-label={profile.avatar.alt} data-avatar-reboot>
              <Avatar data={data} size={44} eager />
            </button>
          ) : (
            <span class="avatar">
              <Avatar data={data} size={44} eager />
            </span>
          )}
          <div class="person-text">
            <p class="who">
              <strong data-slot="profile.name">{profile.name}</strong>
              <span class="muted">
                · <span data-slot="profile.role">{profile.role}</span>
              </span>
            </p>
            {/* Separated by CSS gaps: formatting of this file cannot glue the words together. */}
            <p class="facts mono">
              <span>
                <span data-slot="profile.experience_years">{profile.experience_years}</span>+
              </span>
              <span data-slot="site.hero.experience_label">{hero.experience_label}</span>
              <span aria-hidden="true">·</span>
              <span data-slot="profile.location">{profile.location}</span>
            </p>
          </div>
        </div>
      </div>
    </div>
    {/* Shows when the fingers meet. */}
    <p
      class="link-caption mono"
      data-slot="site.hero.link_caption"
      data-link-caption
      aria-hidden="true"
    >
      {hero.link_caption}
    </p>
    <div class="captions mono">
      <span data-slot="site.hero.captions.left">{hero.captions.left}</span>
      <span class="center" data-slot="site.hero.captions.center">
        {hero.captions.center}
      </span>
      <span class="right" data-slot="site.hero.captions.right">
        {hero.captions.right}
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 260vh;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-rows: 1fr auto;
  }

  .hands {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .text {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 5rem var(--gutter) 0;
    text-align: center;
    will-change: transform, opacity;
  }

  .inner {
    max-width: 52rem;
    display: grid;
    gap: 1.25rem;
    justify-items: center;
  }

  h1 {
    font-size: clamp(2rem, 5.2vw, 4.25rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    font-weight: 500;
    text-wrap: balance;
    animation: kro-up var(--dur-4) var(--ease-out) 0.2s both;
  }

  h1 span {
    display: block;
  }

  .line-muted {
    color: var(--muted);
    font-weight: 300;
  }

  .lead {
    max-width: 36rem;
    color: var(--fg-2);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    text-wrap: pretty;
    animation: kro-up var(--dur-4) var(--ease-out) 0.45s both;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    animation: kro-up var(--dur-4) var(--ease-out) 0.65s both;
  }

  .ctas {
    display: contents;
  }

  .cta {
    gap: 0.5rem;
    height: 2.9rem;
    padding: 0 1.3rem;
    border: 1px solid;
    font-size: 0.95rem;
  }

  .cta:hover {
    transform: translateY(-1px);
  }

  .cta-main {
    background: var(--inverse-bg);
    border-color: var(--inverse-bg);
    color: var(--inverse-fg);
    box-shadow: var(--shadow-1);
  }

  .cta-main:hover {
    color: var(--inverse-fg);
  }

  .cta-line {
    background: var(--surface);
    border-color: var(--line-strong);
    color: var(--fg);
  }

  .discuss {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.9rem;
    padding: 0 0.9rem;
    color: var(--fg-2);
    font-size: 0.95rem;
  }

  .person {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.5rem;
    animation: kro-up var(--dur-4) var(--ease-out) 0.85s both;
  }

  .avatar {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    overflow: hidden;
    background: none;
    cursor: pointer;
  }

  span.avatar {
    cursor: auto;
  }

  .avatar :global(img) {
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface);
  }

  .person-text {
    text-align: left;
    line-height: 1.3;
  }

  .who {
    font-size: 0.9rem;
  }

  .who strong {
    font-weight: 500;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .link-caption {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 3;
    transform: translate(-50%, 3.4rem);
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    opacity: 0;
    transition: opacity var(--dur-2);
  }

  .link-caption:global(.is-shown) {
    opacity: 1;
  }

  .captions {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: end;
    padding: 0 var(--gutter) 1.5rem;
    font-size: 0.72rem;
    color: var(--muted);
    animation: kro-up var(--dur-4) var(--ease-out) 1.1s both;
  }

  .captions .center {
    max-width: 22rem;
    text-align: center;
  }

  /* Two slow pulses, then still: blinking text must stop within five seconds (WCAG 2.2.2). */
  .captions .right {
    text-align: right;
    animation: kro-blink 2.4s ease-in-out 2;
  }

  /* Phones: the captions stay above the floating bar (components/MobileBar.astro). */
  @media (max-width: 900px) {
    .captions {
      padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
    }
  }

  /* Narrow phones: the middle caption goes on top, the two short ones share a line. */
  @media (max-width: 600px) {
    .captions {
      grid-template-columns: 1fr 1fr;
    }

    .captions .center {
      grid-column: 1 / -1;
      order: -1;
      max-width: none;
    }
  }
</style>

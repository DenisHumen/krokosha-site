---
// Quick-contact buttons and the «Discuss a project» form (brief B10.1).
import type { SitePageData } from '../lib/page-data.ts';
import ContactForm from './ContactForm.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  data: SitePageData;
}

const { data } = Astro.props;
const { profile, site } = data;
---

<section class="section" id="contacts" data-section="contacts">
  <h2 data-slot="site.contacts.heading">{site.contacts.heading}</h2>
  <p data-slot="site.contacts.text">{site.contacts.text}</p>
  <SocialLinks
    socials={profile.socials}
    variant="cta"
    ctaLabels={{ telegram: site.hero.cta.telegram }}
  />
  <ContactForm data={data} />
</section>

---
import Achievements from '../../components/Achievements.astro';
import Contacts from '../../components/Contacts.astro';
import Curtain from '../../components/Curtain.astro';
import Hero from '../../components/Hero.astro';
import Projects from '../../components/Projects.astro';
import Services from '../../components/Services.astro';
import Skills from '../../components/Skills.astro';
import Stats from '../../components/Stats.astro';
import { localeFromParam } from '../../i18n/locales.ts';
import Base from '../../layouts/Base.astro';
import { getPageData } from '../../lib/page-data.ts';
import { localeStaticPaths } from '../../lib/routes.ts';
import { absoluteUrl, homeJsonLd, serializeJsonLd } from '../../lib/seo.ts';

export const getStaticPaths = localeStaticPaths;

const data = await getPageData(localeFromParam(Astro.params.lang));
const origin = Astro.site ?? new URL(import.meta.env.SITE);
const jsonLd = homeJsonLd({
  site: origin,
  data,
  avatarUrl: absoluteUrl(origin, data.avatarImages.largest),
  ogImageUrl: absoluteUrl(origin, '/img/og-default.png'),
});

// What the easter eggs need (design/components/eggs/eggs.js): which are on, and their texts in the
// language of the page. Read by scripts/home.ts; not executed, so the CSP has nothing to say.
const telegram = data.profile.socials.find((social) => social.id === 'telegram')?.url;
const { easter_eggs: flags } = data.site.flags;
const panel = flags.enabled && flags['achievements'] !== false;
const eggs = {
  flags: data.site.flags.easter_eggs,
  experience: data.profile.experience_years,
  texts: {
    ...data.site.eggs,
    telegram: telegram?.replace(/^https:\/\//, ''),
  },
};
---

<Base
  data={data}
  page=""
  title={data.seo.title}
  description={data.seo.description}
  jsonLd={[jsonLd]}
  variant="home"
>
  <Hero data={data} />
  <Services data={data} />
  <Skills data={data} />
  <Stats data={data} />
  <Curtain data={data} />
  <Projects data={data} />
  <Contacts data={data} />
  {panel && <Achievements data={data} />}
  <script is:inline type="application/json" id="kro-eggs" set:html={serializeJsonLd(eggs)}></script>
</Base>

<script>
  import { initHome } from '../../scripts/home.ts';

  initHome();
</script>

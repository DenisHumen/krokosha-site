---
// The personal account (docs/architecture.md, 2026-09-24; design v3 — the rail, the header with its
// ticker, tiles): the client's requests and inquiries with their conversations, a new inquiry, the
// discount and the level, the achievements, the profile with its ways in, contacts and devices. No
// password: a one-time code comes by email or from the site's Telegram bot. The page is its frame and
// its texts; scripts/account.ts asks the API, fills it in and switches the screens by the address
// (#requests, #K-0042, #profile…). A service page: not indexed, and none of the site's header.
import '../../styles/account.css';
import { localeFromParam, localePath } from '../../i18n/locales.ts';
import { fill, plural } from '../../i18n/localize.ts';
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/content.ts';
import { getPageData } from '../../lib/page-data.ts';
import { localeStaticPaths } from '../../lib/routes.ts';

export const getStaticPaths = localeStaticPaths;

const lang = localeFromParam(Astro.params.lang);
const data = await getPageData(lang);
const { account: A, loyalty, flags, eggs } = data.site;
const { form } = data.site.contacts;
const { plurals } = getContent().site;
const orders = plurals.orders[lang];
const money = new Intl.NumberFormat(lang, {
  style: 'currency',
  currency: loyalty.currency,
  currencyDisplay: 'narrowSymbol',
  maximumFractionDigits: 0,
});
const eggsOn = flags.easter_eggs.enabled && flags.easter_eggs['achievements'] !== false;
const locales = data.site.i18n.locales;

// The eggs of the site (scripts/achievements.ts → EGGS) and the achievements of orders
// (api/internal/clients/orders.go), in the order the account shows them.
const EGG_IDS = [
  'konami',
  'sudo',
  'croc',
  'cat',
  'reboot',
  'console',
  'croc5',
  'lost_packet',
] as const;
const ORDER_ACHIEVEMENTS = ['first_order', 'second_order', 'big_order', 'all_orders'] as const;

/** «3 orders or $5,000»: what a level asks, whichever comes first. */
function rule(tier: (typeof loyalty.tiers)[number]): string {
  const count = tier.orders > 0 ? `${tier.orders} ${plural(orders, tier.orders, lang)}` : '';
  const sum = tier.spent > 0 ? money.format(tier.spent) : '';
  return count && sum ? fill(A.loyalty.level_rule, { orders: count, spent: sum }) : count || sum;
}

// The ladder of levels: no level yet, then the levels of site.yaml.
const levels = [
  { id: '', name: A.loyalty.base, discount: 0 },
  ...loyalty.tiers.map(({ id, name, discount }) => ({ id, name, discount })),
];

// Icons of the rail and the menu (design v3), 24×24 strokes.
const ICONS = {
  home: 'M4 11l8-7 8 7v9h-5v-6H9v6H4z',
  requests: 'M4 6h16M4 12h16M4 18h10',
  new: 'M12 5v14M5 12h14',
  loyalty:
    'M6 18L18 6M8 8.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM16 18.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z',
  achievements: 'M8 4h8v5a4 4 0 0 1-8 0zM8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 13v4M9 20h6',
  profile: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c0-4 3.6-7 8-7s8 3 8 7',
  out: 'M14 4h5v16h-5M10 8l-4 4 4 4M6 12h10',
  language:
    'M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z',
  site: 'M5 19L19 5M9 5h10v10',
} as const;
const SCREENS = ['home', 'requests', 'new', 'loyalty', 'achievements', 'profile'] as const;

const kinds = Object.entries(A.contacts.kinds);
// What a value of each kind looks like: examples, the same in every language.
const examples: Record<string, string> = {
  phone: '+380 …',
  whatsapp: '+380 …',
  viber: '+380 …',
  signal: '+380 …',
  telegram: '@username',
  linkedin: 'linkedin.com/in/…',
  facebook: 'facebook.com/…',
  instagram: '@username',
  x: '@username',
  discord: 'username',
  skype: 'live:…',
  github: 'username',
  website: 'https://…',
};

// What the script needs: the texts, and the words it builds sentences from. The nickname signs the
// answers in the conversation.
const scriptTexts = JSON.stringify({
  lang,
  account: A,
  nickname: data.profile.nickname,
  plurals: { orders, requests: plurals.requests[lang], open: plurals.open[lang] },
  examples,
  directions: Object.fromEntries(form.directions.map((item) => [item.id, item.label])),
  eggs: Object.fromEntries(EGG_IDS.map((id) => [id, eggs.achievements[id].name])),
  loyalty: {
    enabled: loyalty.enabled,
    currency: loyalty.currency,
    eggs: loyalty.eggs,
    tiers: loyalty.tiers.map(({ id, name, discount, orders: count, spent }) => ({
      id,
      name,
      discount,
      orders: count,
      spent,
    })),
  },
});
---

<Base
  data={data}
  page="account"
  title={`${A.title} — ${data.profile.nickname}`}
  description={A.description}
  noindex
  variant="app"
>
  <div class="cab" data-account data-texts={scriptTexts}>
    <noscript>
      <p class="cab-notice">{A.no_script}</p>
    </noscript>

    <p class="cab-loading needs-js" data-view="loading" role="status">
      <i aria-hidden="true"></i>
      <span data-loading>{A.loading}</span>
    </p>

    {/* Signed out: Telegram or an address, then the code (design v3: «Вход в кабинет»). */}
    <section class="gate" data-view="login" hidden aria-labelledby="login-title">
      <glyph-field class="gate-field" ink="#b9b9b5" cell="14" chars=" .·:·+" fps="12"></glyph-field>
      <div class="gate-frame">
        <div class="gate-card">
          <div class="gate-side">
            <div class="gate-top">
              <a class="gate-logo" href={localePath(lang)} aria-label={A.login.home}>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
              </a>
              <nav class="gate-langs" aria-label={A.login.languages}>
                {locales.map(({ code, label }) => (
                  <a
                    href={localePath(code, 'account')}
                    hreflang={code}
                    lang={code}
                    aria-current={code === lang ? 'page' : undefined}
                  >
                    {label}
                  </a>
                ))}
              </nav>
            </div>

            <div class="gate-head">
              <h1 id="login-title" data-login-title>
                {A.login.title}
              </h1>
              <p data-login-lead>{A.login.lead}</p>
            </div>

            <div class="gate-step" data-login-start>
              <button class="g-btn" type="button" data-login-telegram-start>
                <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="#2aa1da"
                    d="M21.5 3.5L2.8 10.7c-1.3.5-1.2 1.3-.2 1.6l4.8 1.5 1.8 5.6c.2.6.4.8.9.8.4 0 .6-.2.9-.5l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.9-1.4-1.6zM9.6 14.6l-.4 3.9-1.4-4.5 10.4-6.6z"
                  ></path>
                </svg>
                {A.login.telegram}
              </button>
              <p class="g-or">{A.login.or}</p>
              <form class="g-form" data-login-email novalidate>
                <label class="g-label" for="login-email">
                  {A.login.email_label}
                </label>
                <input
                  class="g-input"
                  id="login-email"
                  name="email"
                  type="email"
                  inputmode="email"
                  autocomplete="email"
                  maxlength="200"
                  required
                  placeholder={A.login.email_placeholder}
                  aria-describedby="login-email-hint"
                />
                <p class="g-hint" id="login-email-hint">
                  {A.login.email_hint}
                </p>
                <button class="g-btn g-btn-dark" type="submit">
                  {A.login.send}
                </button>
              </form>
              <p class="g-note">
                <span>{A.login.no_account}</span>
                <span>{A.login.note}</span>
              </p>
            </div>

            <div class="gate-step" data-login-telegram hidden>
              <a
                class="g-btn g-btn-dark is-waiting"
                href={localePath(lang, 'account')}
                target="_blank"
                rel="noopener"
                aria-disabled="true"
                data-bot-link
              >
                <span data-bot-label>{A.login.telegram_open}</span>
                <span aria-hidden="true">↗</span>
              </a>
              <button class="g-link" type="button" data-login-back>
                {A.login.by_email}
              </button>
            </div>

            {/* A link of a letter or of the bot asks first: one somebody else sent would open their account. */}
            <div class="gate-step" data-login-link hidden>
              <p class="g-hint" data-link-account></p>
              <p class="g-hint">{A.login.link_note}</p>
              <button class="g-btn g-btn-dark" type="button" data-link-yes>
                {A.login.link_yes}
              </button>
              <button class="g-link" type="button" data-link-no>
                {A.login.link_no}
              </button>
            </div>

            <form class="gate-step" data-login-code hidden novalidate>
              <label class="visually-hidden" for="login-code">
                {A.login.code}
              </label>
              <div class="code-box">
                <input
                  class="code-input"
                  id="login-code"
                  name="code"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  pattern="[0-9]{6}"
                  maxlength="6"
                  required
                  aria-describedby="login-code-hint"
                />
                <span class="code-cells" aria-hidden="true">
                  <span data-cell></span>
                  <span data-cell></span>
                  <span data-cell></span>
                  <span data-cell></span>
                  <span data-cell></span>
                  <span data-cell></span>
                </span>
              </div>
              <p class="g-hint" id="login-code-hint">
                {A.login.code_hint}
                <button class="g-resend" type="button" data-resend hidden></button>
              </p>
              <button class="g-btn g-btn-dark" type="submit">
                {A.login.submit}
              </button>
              <a
                class="g-btn"
                href={localePath(lang, 'account')}
                target="_blank"
                rel="noopener"
                data-code-bot
                hidden
              >
                <span data-bot-label>{A.login.telegram_open}</span>
                <span aria-hidden="true">↗</span>
              </a>
              <button class="g-link" type="button" data-login-back>
                {A.login.back}
              </button>
            </form>

            <p class="g-error" role="alert" data-login-error></p>
          </div>
          <div class="gate-art" aria-hidden="true">
            <glyph-field
              ink="#121212"
              cell="10"
              mask="right"
              intensity="1.25"
              chars=" ·:+◆◆"
              fps="12"
            ></glyph-field>
          </div>
        </div>
      </div>
    </section>

    {/* Signed in: the rail, the header, the screens. */}
    <div class="app" data-view="app" hidden>
      <glyph-field
        class="app-field"
        ink="#2b2b30"
        accent="#3f4668"
        cell="13"
        intensity="0.9"
        fps="12"
      ></glyph-field>

      <nav class="rail" aria-label={A.nav.label}>
        <a class="rail-logo" href={localePath(lang)} aria-label={A.login.home}>
          {Array.from({ length: 9 }, () => (
            <span></span>
          ))}
        </a>
        <ul class="rail-list">
          {SCREENS.map((id) => (
            <li data-nav-item={id}>
              <a
                class="rail-link"
                href={`#${id}`}
                data-nav={id}
                aria-label={A.nav[id]}
                title={A.nav[id]}
              >
                <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={ICONS[id]}></path>
                </svg>
                {id === 'requests' && (
                  <span class="rail-dot" data-unread-dot hidden>
                    <span class="visually-hidden">{A.requests.unread}</span>
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
        <button
          class="rail-link rail-out"
          type="button"
          data-logout
          aria-label={A.menu.sign_out}
          title={A.menu.sign_out}
        >
          <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true">
            <path d={ICONS.out}></path>
          </svg>
        </button>
      </nav>

      <div class="panel">
        <header class="top">
          <div class="top-left">
            <span class="brand">KROKOSHA</span>
            <dl class="ticker" aria-label={A.ticker.label}>
              <div data-loyalty-only>
                <dt>{A.ticker.discount}</dt>
                <dd data-tick="discount">—</dd>
              </div>
              <div data-loyalty-only>
                <dt>{A.ticker.level}</dt>
                <dd data-tick="level">—</dd>
              </div>
              <div>
                <dt>{A.ticker.open}</dt>
                <dd data-tick="open">—</dd>
              </div>
              <div>
                <dt>{A.ticker.answer}</dt>
                <dd data-tick="answer">—</dd>
              </div>
            </dl>
          </div>
          <a class="add" href="#new" aria-label={A.nav.new}>
            <span class="add-plus" aria-hidden="true">
              +
            </span>
            <span class="add-label" aria-hidden="true">
              {A.home.inquiry}
            </span>
          </a>
          <details class="menu" data-menu>
            <summary class="who" aria-label={A.menu.open}>
              <span class="avatar" data-initials aria-hidden="true"></span>
              <span class="who-text" aria-hidden="true">
                <span class="who-name" data-who-name></span>
                <span class="who-id" data-who-id></span>
              </span>
            </summary>
            <div class="menu-panel">
              <a class="menu-item" href="#profile">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={ICONS.profile}></path>
                </svg>
                <span>{A.nav.profile}</span>
              </a>
              <a class="menu-item" href="#loyalty" data-loyalty-only>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={ICONS.loyalty}></path>
                </svg>
                <span>{A.nav.loyalty}</span>
                <span class="menu-hint" data-menu-discount></span>
              </a>
              <div class="menu-item menu-langs">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={ICONS.language}></path>
                </svg>
                <span id="menu-language">{A.menu.language}</span>
                <span class="menu-hint" role="group" aria-labelledby="menu-language">
                  {locales.map(({ code, label }) => (
                    <a
                      href={localePath(code, 'account')}
                      hreflang={code}
                      lang={code}
                      aria-current={code === lang ? 'page' : undefined}
                      data-lang-link
                    >
                      {label}
                    </a>
                  ))}
                </span>
              </div>
              <a class="menu-item" href={localePath(lang)}>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={ICONS.site}></path>
                </svg>
                <span>{A.menu.site}</span>
                <span class="menu-hint" aria-hidden="true">
                  ↗
                </span>
              </a>
              <hr class="menu-rule" />
              <button class="menu-item" type="button" data-logout>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={ICONS.out}></path>
                </svg>
                <span>{A.menu.sign_out}</span>
              </button>
            </div>
          </details>
        </header>

        <div class="content">
          <div class="head">
            <h1 tabindex="-1" data-title>
              {A.home.hello_plain}
            </h1>
            <span class="since" data-since></span>
          </div>

          {/* The home screen. */}
          <section class="screen grid grid-home" data-screen="home" aria-labelledby="home-summary">
            <h2 class="visually-hidden" id="home-summary">
              {A.nav.home}
            </h2>
            <a class="tile tile-accent t-discount" href="#loyalty" data-loyalty-only>
              <span class="tile-label">{A.home.discount}</span>
              <span class="num-row">
                <span class="num" data-offer>
                  —
                </span>
                <span class="num-sub" data-offer-reason></span>
              </span>
            </a>
            <a class="tile t-requests" href="#requests" data-home-requests>
              <span class="tile-label">{A.home.requests}</span>
              <span class="t-requests-body">
                <span class="num-row">
                  <span class="num num-xl" data-count>
                    0
                  </span>
                  <span class="num-sub" data-open></span>
                </span>
                <span class="t-rule">
                  <span data-answer-label>{A.home.no_answers}</span>
                  <span data-answer-at></span>
                </span>
              </span>
            </a>
            <div class="tile t-level" data-loyalty-only>
              <div class="tile-head">
                <span class="tile-label">{A.loyalty.level}</span>
                <span class="tabs" aria-hidden="true">
                  {levels.map((level) => (
                    <span class="tab" data-level={level.id}>
                      {level.name}
                    </span>
                  ))}
                </span>
              </div>
              <div class="level-body">
                <p class="level-text">
                  <span class="level-name" data-level-name>
                    {A.loyalty.base}
                  </span>
                  <span class="level-next" data-level-next></span>
                </p>
                <div class="ladder" aria-hidden="true">
                  {levels.map((level) => (
                    <div class="rung" data-rung={level.id}>
                      <span class="rung-label" data-rung-label>
                        {level.discount}%
                      </span>
                      <span class="rung-bar" data-rung-bar></span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <a class="tile t-ordered" href="#loyalty" data-loyalty-only>
              <span class="tile-label">{A.home.ordered}</span>
              <span class="num-row">
                <span class="num" data-spent>
                  —
                </span>
                <span class="num-sub" data-orders></span>
              </span>
            </a>
            <section class="tile t-latest" aria-labelledby="latest-title">
              <div class="tile-head">
                <h3 class="tile-label" id="latest-title">
                  {A.home.latest}
                </h3>
                <a class="round" href="#requests" aria-label={A.home.all}>
                  ↗
                </a>
              </div>
              <ul class="rows" data-latest></ul>
              <p class="empty" data-latest-empty hidden>
                {A.requests.empty}
              </p>
            </section>
            <a class="tile tile-accent t-ask" href="#new">
              <svg class="t-ask-art" viewBox="0 0 200 200" aria-hidden="true">
                <circle cx="100" cy="100" r="90"></circle>
                <path d="M100 100L100 10M100 100L150 25M100 100L190 100"></path>
              </svg>
              <span class="t-ask-title">{A.home.ask_title}</span>
              <span class="t-ask-text" data-ask-text></span>
              <span class="chip-light">
                {A.home.ask} <span aria-hidden="true">→</span>
              </span>
            </a>
            {eggsOn && (
              <a class="tile t-eggs" href="#achievements">
                <span class="ring">
                  <svg viewBox="0 0 140 140" aria-hidden="true">
                    <circle class="ring-track" cx="70" cy="70" r="64"></circle>
                    <circle
                      class="ring-value"
                      cx="70"
                      cy="70"
                      r="64"
                      stroke-dasharray="0 403"
                      data-ring
                    ></circle>
                  </svg>
                  <span class="ring-text">
                    <span class="ring-num" data-eggs-count>
                      0/{EGG_IDS.length}
                    </span>
                    <span class="ring-label">{A.home.eggs}</span>
                  </span>
                </span>
                <span class="t-eggs-text" data-eggs-hint></span>
              </a>
            )}
            <a class="tile tile-beige t-project" href={`${localePath(lang)}#contacts`}>
              <span class="t-project-title">{A.home.project}</span>
              <span class="t-project-side">
                <span data-project-note>{A.home.project_plain}</span>
                <span class="round round-dark" aria-hidden="true">
                  ↗
                </span>
              </span>
            </a>
          </section>

          {/* Requests as a messenger (handoff «Заявки — компактный чат»): the list in one-line
              rows, and the open request as a conversation with the field to write pinned under it.
              The screen takes the height of the window: only the list and the conversation scroll. */}
          <section
            class="screen split-requests"
            data-screen="requests"
            hidden
            aria-labelledby="requests-title"
          >
            <div class="pane req-list">
              <h2 class="req-list-title" id="requests-title">
                {A.requests.title} · <span data-total>0</span>
              </h2>
              <div class="req-search">
                <label class="visually-hidden" for="requests-search">
                  {A.requests.search}
                </label>
                <input
                  id="requests-search"
                  type="search"
                  autocomplete="off"
                  maxlength="100"
                  placeholder={A.requests.search}
                  data-requests-search
                />
              </div>
              <div class="req-cols" aria-hidden="true">
                <span class="req-num">{A.requests.number}</span>
                <span class="req-main">{A.requests.request}</span>
                <span class="req-status">{A.requests.status}</span>
                <span class="req-time">{A.requests.time}</span>
              </div>
              <div class="req-scroll">
                <ul class="req-rows" data-requests-list></ul>
                <p class="req-empty" data-requests-empty hidden>
                  {A.requests.empty}
                </p>
                <p class="req-empty" data-requests-nothing hidden>
                  {A.requests.nothing}
                </p>
              </div>
              <p class="req-foot" data-requests-foot></p>
            </div>

            <section class="pane chat" data-thread hidden aria-labelledby="thread-title">
              <div class="chat-head">
                <a
                  class="chat-back"
                  href="#requests"
                  aria-label={A.requests.back}
                  title={A.requests.back}
                >
                  <span aria-hidden="true">←</span>
                </a>
                <span class="chat-num" data-thread-number></span>
                <h2 class="chat-title" id="thread-title" tabindex="-1" data-thread-title>
                  {A.requests.request}
                </h2>
                <span class="status chat-status" data-thread-status></span>
                <span class="chat-facts" data-thread-summary></span>
              </div>
              {/* The facts of the request fold away under «Details» — a <details>, which opens
                  and closes by itself — with the way to ask about the request. */}
              <details class="chat-details" data-thread-details>
                <summary class="chat-more">
                  <span class="chat-more-label">{A.requests.details}</span>
                  <span class="chat-more-arrow" aria-hidden="true">
                    ▾
                  </span>
                </summary>
                <div class="chat-info">
                  <dl class="facts" data-thread-facts></dl>
                  <p class="chat-info-bar">
                    <button class="btn btn-s" type="button" data-thread-ask>
                      {A.requests.ask}
                    </button>
                  </p>
                </div>
              </details>
              <div class="chat-feed" data-thread-scroll>
                <ol class="thread" data-thread-feed aria-label={A.requests.conversation}></ol>
              </div>
              <form class="composer" data-thread-reply novalidate>
                <p class="done" role="status" data-done></p>
                <p class="error" role="alert" data-error></p>
                <div class="composer-row">
                  <label class="visually-hidden" for="reply-text">
                    {A.requests.write}
                  </label>
                  <textarea
                    id="reply-text"
                    name="text"
                    rows="1"
                    maxlength="4000"
                    enterkeyhint="send"
                    placeholder={A.requests.message}
                  ></textarea>
                  <button
                    class="btn btn-accent composer-send"
                    type="submit"
                    title={A.requests.keys}
                  >
                    {A.requests.send} <span aria-hidden="true">→</span>
                  </button>
                </div>
              </form>
              <div class="closed" data-thread-closed hidden>
                <p>{A.requests.closed}</p>
                <button class="btn btn-s" type="button" data-thread-ask>
                  {A.requests.ask}
                </button>
              </div>
            </section>
            <p class="pane chat-none" data-thread-none hidden></p>
          </section>

          {/* A new inquiry. */}
          <section
            class="screen split-new"
            data-screen="new"
            hidden
            aria-labelledby="inquiry-title"
          >
            <form class="tile form-card" data-inquiry novalidate>
              <h2 class="tile-label" id="inquiry-title">
                {A.inquiry.title}
              </h2>
              <label class="field">
                <span class="field-label">{A.inquiry.parent}</span>
                <select id="inquiry-parent" name="parent" data-parent>
                  <option value="">{A.inquiry.none}</option>
                </select>
              </label>
              <label class="field">
                <span class="field-label">{A.inquiry.subject}</span>
                <input
                  id="inquiry-subject"
                  name="subject"
                  maxlength="150"
                  autocomplete="off"
                  placeholder={A.inquiry.subject_placeholder}
                />
              </label>
              <label class="field">
                <span class="field-label">{A.inquiry.text}</span>
                <textarea
                  id="inquiry-text"
                  name="text"
                  rows="7"
                  maxlength="4000"
                  required
                  placeholder={A.inquiry.text_placeholder}
                ></textarea>
              </label>
              <p class="error" role="alert" data-error></p>
              <button class="btn btn-accent btn-m" type="submit">
                {A.inquiry.send} <span aria-hidden="true">→</span>
              </button>
            </form>
            <section class="tile tile-beige how" aria-labelledby="how-title">
              <h2 class="tile-label" id="how-title">
                {A.inquiry.how}
              </h2>
              <ol class="how-steps">
                <li>
                  <span aria-hidden="true">01</span>
                  <span>{A.inquiry.step_number}</span>
                </li>
                <li>
                  <span aria-hidden="true">02</span>
                  <span>{A.inquiry.step_answer}</span>
                </li>
                <li>
                  <span aria-hidden="true">03</span>
                  <span>{A.inquiry.step_parent}</span>
                </li>
              </ol>
            </section>
          </section>

          {/* The discount and the level. */}
          <section
            class="screen grid grid-loyalty"
            data-screen="loyalty"
            hidden
            aria-labelledby="next-title"
          >
            <div class="tile tile-accent t-next">
              <svg class="t-next-art" viewBox="0 0 200 200" aria-hidden="true">
                <circle cx="100" cy="100" r="90"></circle>
                <circle cx="100" cy="100" r="55"></circle>
              </svg>
              <h2 class="tile-label" id="next-title">
                {A.loyalty.next}
              </h2>
              <p class="t-next-body">
                <span class="num num-hero" data-next-percent>
                  —
                </span>
                <span class="t-next-sub" data-next-reason></span>
              </p>
            </div>
            <div class="tile t-progress">
              <h2 class="tile-label">{A.loyalty.orders}</h2>
              <p class="num-row">
                <span class="num" data-orders-count>
                  0
                </span>
                <span class="num-sub" data-orders-target></span>
              </p>
              <span class="meter" aria-hidden="true">
                <span data-orders-bar></span>
              </span>
            </div>
            <div class="tile t-progress">
              <h2 class="tile-label">{A.loyalty.spent}</h2>
              <p class="num-row">
                <span class="num" data-spent-total>
                  —
                </span>
                <span class="num-sub" data-spent-target></span>
              </p>
              <span class="meter meter-beige" aria-hidden="true">
                <span data-spent-bar></span>
              </span>
            </div>
            <p class="tile t-personal" data-personal hidden></p>
            <section class="tile t-tiers" aria-labelledby="levels-title">
              <h2 class="tile-label" id="levels-title">
                {A.loyalty.levels}
              </h2>
              <ul class="tiers">
                <li class="tier-row" data-row="welcome">
                  <span class="tier-dot" aria-hidden="true"></span>
                  <span class="tier-name">
                    {A.loyalty.welcome}
                    <span data-state></span>
                  </span>
                  <span class="tier-rule">{A.loyalty.once}</span>
                  <span class="tier-pct">{loyalty.welcome}%</span>
                </li>
                {eggsOn && (
                  <li class="tier-row" data-row="eggs">
                    <span class="tier-dot" aria-hidden="true"></span>
                    <span class="tier-name">
                      {A.loyalty.eggs}
                      <span data-state></span>
                    </span>
                    <span class="tier-rule" data-eggs-rule>
                      {A.loyalty.once}
                    </span>
                    <span class="tier-pct">{loyalty.eggs}%</span>
                  </li>
                )}
                {loyalty.tiers.map((tier) => (
                  <li class="tier-row" data-row="tier" data-tier-id={tier.id}>
                    <span class="tier-dot" aria-hidden="true"></span>
                    <span class="tier-name">
                      {tier.name}
                      <span data-state></span>
                    </span>
                    <span class="tier-rule">{rule(tier)}</span>
                    <span class="tier-pct">{tier.discount}%</span>
                  </li>
                ))}
              </ul>
              <p class="rules-note">
                {fill(A.loyalty.rules, { welcome: loyalty.welcome, eggs: loyalty.eggs })}
              </p>
            </section>
          </section>

          {/* Achievements: those of orders, and the eggs of the site. */}
          <section
            class="screen grid grid-ach"
            data-screen="achievements"
            hidden
            aria-labelledby="orders-title"
          >
            <h2 class="visually-hidden" id="orders-title">
              {A.orders.title}
            </h2>
            {ORDER_ACHIEVEMENTS.map((id) => (
              <article class="tile ach" data-order={id}>
                <p class="ach-top">
                  <span>{A.orders.title}</span>
                  <span data-rarity></span>
                </p>
                <div class="ach-body">
                  <h3 class="ach-name">{A.orders[id].name}</h3>
                  <p class="ach-text">
                    {fill(A.orders[id].text, { amount: money.format(loyalty.big_order) })}
                  </p>
                  <p class="ach-state" data-state>
                    {A.orders.locked}
                  </p>
                </div>
              </article>
            ))}
            {eggsOn && (
              <section class="tile t-eggs-grid" aria-labelledby="eggs-title">
                <div class="tile-head">
                  <h2 class="tile-label" id="eggs-title">
                    {A.eggs.heading} · <span data-eggs-found>0/{EGG_IDS.length}</span>
                  </h2>
                  <span class="aside" data-eggs-reward data-loyalty-only>
                    {fill(A.eggs.reward, { total: EGG_IDS.length, percent: loyalty.eggs })}
                  </span>
                </div>
                <ul class="eggs">
                  {EGG_IDS.map((id) => (
                    <li class="egg" data-egg={id}>
                      <span class="egg-mark" aria-hidden="true">
                        ◇
                      </span>
                      <span class="egg-name" data-name>
                        {A.eggs.hidden}
                      </span>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </section>

          {/* The profile, the ways in, contacts, devices. */}
          <section
            class="screen grid grid-profile"
            data-screen="profile"
            hidden
            aria-labelledby="profile-title"
          >
            <form class="tile form-card" data-profile novalidate>
              <h2 class="tile-label" id="profile-title">
                {A.profile.title}
              </h2>
              <label class="field">
                <span class="field-label">{A.profile.name}</span>
                <input id="profile-name" name="name" maxlength="100" autocomplete="name" />
              </label>
              <label class="field">
                <span class="field-label">{A.profile.company}</span>
                <input
                  id="profile-company"
                  name="company"
                  maxlength="120"
                  autocomplete="organization"
                />
              </label>
              <fieldset class="chips-field">
                <legend class="field-label">{A.profile.lang}</legend>
                <span class="chips">
                  {locales.map(({ code, label }) => (
                    <label class="chip">
                      <input type="radio" name="lang" value={code} />
                      <span>{label}</span>
                    </label>
                  ))}
                </span>
              </fieldset>
              <fieldset class="chips-field">
                <legend class="field-label">{A.profile.preferred}</legend>
                <span class="chips">
                  <label class="chip">
                    <input type="radio" name="preferred" value="telegram" />
                    <span>{A.profile.preferred_telegram}</span>
                  </label>
                  <label class="chip">
                    <input type="radio" name="preferred" value="email" />
                    <span>{A.profile.preferred_email}</span>
                  </label>
                </span>
              </fieldset>
              <div class="form-bar">
                <button class="btn btn-accent" type="submit">
                  {A.profile.save}
                </button>
                <span class="done" role="status" data-done></span>
              </div>
            </form>

            <section class="tile" data-access aria-labelledby="access-title">
              <h2 class="tile-label" id="access-title">
                {A.access.title}
              </h2>
              <div class="ways">
                <div class="way">
                  <p class="way-text">
                    <span class="way-label">{A.access.email}</span>
                    <span class="way-value" data-access-email></span>
                  </p>
                  <button class="btn btn-s" type="button" data-email-change></button>
                </div>
                <div class="way">
                  <p class="way-text">
                    <span class="way-label">{A.access.telegram}</span>
                    <span class="way-value" data-access-telegram></span>
                  </p>
                  <button class="btn btn-s" type="button" data-telegram-link>
                    {A.access.link_telegram}
                  </button>
                  <button class="btn btn-s" type="button" data-telegram-unlink>
                    {A.access.unlink}
                  </button>
                </div>
              </div>
              <form class="way-form" data-access-email-form hidden novalidate>
                <label class="field">
                  <span class="field-label">{A.login.email_label}</span>
                  <input
                    id="access-email"
                    name="email"
                    type="email"
                    inputmode="email"
                    autocomplete="email"
                    maxlength="200"
                    required
                  />
                </label>
                <div class="form-bar">
                  <button class="btn btn-accent" type="submit">
                    {A.login.send}
                  </button>
                  <button class="btn" type="button" data-access-cancel>
                    {A.access.cancel}
                  </button>
                </div>
              </form>
              <form class="way-form" data-access-code-form hidden novalidate>
                <p class="way-sent" data-sent></p>
                <a
                  class="btn btn-accent"
                  href={localePath(lang, 'account')}
                  target="_blank"
                  rel="noopener"
                  data-access-bot
                  hidden
                >
                  {A.login.telegram_open} <span aria-hidden="true">↗</span>
                </a>
                <label class="field">
                  <span class="field-label">{A.login.code}</span>
                  <input
                    class="code-plain"
                    id="access-code"
                    name="code"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    required
                  />
                </label>
                <div class="form-bar">
                  <button class="btn btn-accent" type="submit">
                    {A.login.submit}
                  </button>
                  <button class="btn" type="button" data-access-cancel>
                    {A.access.cancel}
                  </button>
                </div>
              </form>
              <p class="error" role="alert" data-error></p>
              <p class="ok-note" role="status" data-access-status hidden>
                {A.access.merged}
              </p>
              <p class="note" data-access-hint hidden>
                {A.access.join_hint}
              </p>

              <h3 class="tile-label sub-label" id="contacts-title">
                {A.contacts.title}
              </h3>
              <ul class="contacts" data-contact-list aria-labelledby="contacts-title"></ul>
              <p class="empty" data-contacts-empty hidden>
                {A.contacts.empty}
              </p>
              <form class="contact-add" data-contact-form novalidate>
                <label class="visually-hidden" for="contact-kind">
                  {A.contacts.kind}
                </label>
                <select id="contact-kind" name="kind">
                  {kinds.map(([id, label]) => (
                    <option value={id}>{label}</option>
                  ))}
                </select>
                <label class="visually-hidden" for="contact-value">
                  {A.contacts.value}
                </label>
                <input
                  id="contact-value"
                  name="value"
                  maxlength="200"
                  autocomplete="off"
                  required
                  placeholder={examples[kinds[0]?.[0] ?? 'phone']}
                />
                <button class="btn btn-s" type="submit">
                  + {A.contacts.add}
                </button>
              </form>
              <p class="error" role="alert" data-contact-error></p>
            </section>

            <div class="stack">
              <section class="tile" data-sessions aria-labelledby="sessions-title">
                <div class="tile-head">
                  <h2 class="tile-label" id="sessions-title">
                    {A.sessions.title}
                  </h2>
                  <button class="link-btn" type="button" data-sessions-end-all hidden>
                    {A.sessions.end_all}
                  </button>
                </div>
                <ul class="devices" data-session-list></ul>
              </section>

              <section class="tile tile-danger" aria-labelledby="delete-title">
                <h2 class="tile-label warn" id="delete-title">
                  {A.delete.title}
                </h2>
                <p class="danger-text">{A.delete.text}</p>
                <form class="danger-form" data-delete novalidate>
                  <label class="check">
                    <input type="checkbox" name="confirm" data-delete-confirm />
                    <span>{A.delete.confirm}</span>
                  </label>
                  <button class="btn btn-danger" type="submit" disabled data-delete-button>
                    {A.delete.button}
                  </button>
                </form>
              </section>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>

  {/* Rows the script clones: a request of the list, a line of the home screen, a message of the
      conversation, a contact, a device. */}
  <template id="tpl-request">
    <li>
      <a class="req" href="#requests">
        <span class="req-num" data-number></span>
        <span class="req-main">
          <span class="req-title" data-title></span>
          <span class="req-sub" data-excerpt></span>
        </span>
        <span class="req-status">
          <span class="status" data-status></span>
        </span>
        <span class="req-time">
          <span class="dot" data-unread hidden>
            <span class="visually-hidden">{A.requests.unread}</span>
          </span>
          <time data-time></time>
        </span>
      </a>
    </li>
  </template>
  <template id="tpl-row">
    <li>
      <a class="row" href="#requests">
        <span class="row-num" data-number></span>
        <span class="row-main">
          <span class="row-title" data-title></span>
          <span class="row-sub" data-sub></span>
        </span>
        <span class="row-end">
          <span class="dot" data-unread hidden>
            <span class="visually-hidden">{A.requests.unread}</span>
          </span>
          <span class="status" data-status></span>
        </span>
      </a>
    </li>
  </template>
  <template id="tpl-msg">
    <li class="msg">
      <span class="msg-head" data-head></span>
      <div class="bubble">
        <ul class="msg-files" data-files aria-label={A.requests.files} hidden></ul>
        <p class="msg-line">
          <span class="msg-body" data-body></span>
          <time class="msg-time" data-time></time>
        </p>
      </div>
    </li>
  </template>
  <template id="tpl-contact">
    <li class="contact">
      <span class="contact-text">
        <span class="contact-kind" data-kind></span>
        <span class="contact-value" data-value></span>
      </span>
      <button class="x" type="button" data-remove>
        ×
      </button>
    </li>
  </template>
  <template id="tpl-session">
    <li class="device">
      <span class="device-text">
        <span class="device-name" data-device></span>
        <span class="device-seen" data-seen></span>
      </span>
      <span class="device-current" data-current hidden>
        {A.sessions.current}
      </span>
      <button class="link-btn" type="button" data-end>
        {A.sessions.end}
      </button>
    </li>
  </template>
</Base>

<script>
  import { initAccount } from '../../scripts/account.ts';

  initAccount();
</script>

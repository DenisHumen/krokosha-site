---
// The personal account (docs/architecture.md, 2026-09-24; api/internal/clients): the client's requests
// and inquiries with their statuses and conversations, the discount of the next request and the level
// of a regular client, contacts and social networks, the ways to sign in, the devices. No password: a
// one-time code comes by email or from the site's Telegram bot. Everything here is the page's frame
// and its texts; scripts/account.ts asks the API and fills it in. A service page: not indexed.
import Achievements from '../../components/Achievements.astro';
import { localeFromParam, localePath } from '../../i18n/locales.ts';
import { fill, plural } from '../../i18n/localize.ts';
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/content.ts';
import { getPageData } from '../../lib/page-data.ts';
import { localeStaticPaths } from '../../lib/routes.ts';

export const getStaticPaths = localeStaticPaths;

const lang = localeFromParam(Astro.params.lang);
const data = await getPageData(lang);
const { account, loyalty, flags } = data.site;
const { form } = data.site.contacts;
const orders = getContent().site.plurals.orders[lang];
const money = new Intl.NumberFormat(lang, {
  style: 'currency',
  currency: loyalty.currency,
  maximumFractionDigits: 0,
});
const panel = flags.easter_eggs.enabled && flags.easter_eggs['achievements'] !== false;
// The achievements of orders (api/internal/clients/orders.go), in the order the account shows them.
const ORDER_ACHIEVEMENTS = ['first_order', 'second_order', 'big_order', 'all_orders'] as const;

/** «3 orders or $5,000»: what a level asks, whichever comes first. */
function rule(tier: (typeof loyalty.tiers)[number]): string {
  const count = tier.orders > 0 ? `${tier.orders} ${plural(orders, tier.orders, lang)}` : '';
  const sum = tier.spent > 0 ? money.format(tier.spent) : '';
  return count && sum
    ? fill(account.loyalty.level_rule, { orders: count, spent: sum })
    : count || sum;
}

const kinds = Object.entries(account.contacts.kinds);
// What a value of each kind looks like: examples, the same in every language.
const examples: Record<string, string> = {
  phone: '+380 …',
  whatsapp: '+380 …',
  viber: '+380 …',
  signal: '+380 …',
  telegram: '@username',
  linkedin: 'linkedin.com/in/…',
  facebook: 'facebook.com/…',
  instagram: '@username',
  x: '@username',
  discord: 'username',
  skype: 'live:…',
  github: 'username',
  website: 'https://…',
};

// What the script needs: the texts, and the words it builds sentences from.
const scriptTexts = JSON.stringify({
  lang,
  account,
  orders,
  examples,
  directions: Object.fromEntries(form.directions.map((item) => [item.id, item.label])),
  loyalty: {
    enabled: loyalty.enabled,
    currency: loyalty.currency,
    eggs: loyalty.eggs,
    tiers: loyalty.tiers.map(({ id, name, discount }) => ({ id, name, discount })),
  },
});
---

<Base
  data={data}
  page="account"
  title={`${account.title} — ${data.profile.nickname}`}
  description={account.description}
  noindex
>
  <div class="account" data-account data-texts={scriptTexts}>
    <noscript>
      <p class="notice">{account.no_script}</p>
    </noscript>

    <p class="loading mono needs-js" data-view="loading" role="status">
      <i aria-hidden="true"></i>
      <span data-loading>{account.loading}</span>
    </p>

    {/* Signed out: an address or Telegram, then the code. */}
    <section class="login" data-view="login" hidden aria-labelledby="login-title">
      <p class="status mono">
        <i aria-hidden="true"></i>AUTH · ONE-TIME CODE
      </p>
      <h1 id="login-title">{account.title}</h1>
      <p class="lead">{account.login.lead}</p>

      <div class="login-card">
        <fieldset class="choose" data-login-methods>
          <legend class="label">{account.login.method}</legend>
          <span class="methods">
            <label class="method">
              <input type="radio" name="login-method" value="email" checked />
              <span>{account.login.email}</span>
            </label>
            <label class="method">
              <input type="radio" name="login-method" value="telegram" />
              <span>{account.login.telegram}</span>
            </label>
          </span>
        </fieldset>

        <form class="step" data-login-email novalidate>
          <label class="label" for="login-email">
            {account.login.email_label}
          </label>
          <input
            id="login-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            maxlength="200"
            required
            placeholder="you@company.com"
          />
          <button class="pill pill-inverse submit" type="submit">
            {account.login.send}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </button>
        </form>

        <div class="step" data-login-telegram hidden>
          <p class="muted">{account.login.telegram_text}</p>
          <a
            class="pill pill-inverse submit is-waiting"
            href={localePath(lang, 'account')}
            target="_blank"
            rel="noopener"
            aria-disabled="true"
            data-bot-link
          >
            {account.login.telegram_open}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>

        <form class="step" data-login-code hidden novalidate>
          <p class="sent" data-sent></p>
          <label class="label" for="login-code">
            {account.login.code}
          </label>
          <input
            class="code mono"
            id="login-code"
            name="code"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{6}"
            maxlength="6"
            required
          />
          <p class="row">
            <button class="pill pill-inverse submit" type="submit">
              {account.login.submit}
            </button>
            <button class="link" type="button" data-login-back>
              {account.login.back}
            </button>
          </p>
        </form>

        <p class="error" role="alert" data-login-error></p>
      </div>
      <p class="note muted">{account.login.note}</p>
    </section>

    {/* Signed in. */}
    <div class="dashboard" data-view="dashboard" hidden>
      <header class="head">
        <p class="status mono">
          <i aria-hidden="true"></i>SESSION · ESTABLISHED
        </p>
        <h1 data-hello>{account.title}</h1>
        <p class="muted" data-since></p>
        <p class="row">
          <a class="pill pill-inverse cta" href={`${localePath(lang)}#contacts`}>
            {account.home.new_request}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
          <button class="pill pill-line cta" type="button" data-logout>
            {account.home.sign_out}
          </button>
        </p>
      </header>

      <div class="columns">
        <div class="stack">
          <section class="card" aria-labelledby="requests-title" data-requests>
            <div data-list-view>
              <h2 class="card-title" id="requests-title">
                {account.requests.title}
              </h2>
              <p class="muted" data-requests-empty hidden>
                {account.requests.empty}
              </p>
              <ul class="requests" data-requests-list></ul>
            </div>

            <article class="thread" data-thread hidden aria-live="polite">
              <button class="link back mono" type="button" data-thread-back>
                <span aria-hidden="true">←</span>
                {account.requests.back}
              </button>
              <header class="thread-head">
                <p class="mono muted" data-thread-meta></p>
                <h2 class="card-title" data-thread-title>
                  {account.requests.request}
                </h2>
                <span class="pill-status" data-thread-status></span>
              </header>
              <dl class="facts" data-thread-facts></dl>
              <p class="description" data-thread-description></p>
              <h3 class="subtitle mono">{account.requests.conversation}</h3>
              <ol class="feed" data-thread-feed></ol>
              <form class="reply" data-thread-reply novalidate>
                <label class="visually-hidden" for="reply-text">
                  {account.requests.write}
                </label>
                <textarea
                  id="reply-text"
                  name="text"
                  rows="3"
                  maxlength="4000"
                  placeholder={account.requests.write}
                ></textarea>
                <p class="field-error" role="alert" data-error></p>
                <p class="row">
                  <button class="pill pill-inverse submit" type="submit">
                    {account.requests.send}
                  </button>
                  <span class="done mono" role="status" data-done></span>
                </p>
              </form>
              <p class="muted" data-thread-closed hidden>
                {account.requests.closed}
              </p>
              <button class="link ask" type="button" data-thread-ask>
                {account.requests.ask} <span aria-hidden="true">→</span>
              </button>
            </article>
          </section>

          <section class="card" aria-labelledby="inquiry-title" id="inquiry">
            <h2 class="card-title" id="inquiry-title">
              {account.inquiry.title}
            </h2>
            <p class="muted">{account.inquiry.lead}</p>
            <form class="fields" data-inquiry novalidate>
              <label class="label" for="inquiry-parent">
                {account.inquiry.parent}
              </label>
              <select id="inquiry-parent" name="parent" data-parent>
                <option value="">{account.inquiry.none}</option>
              </select>
              <label class="label" for="inquiry-subject">
                {account.inquiry.subject}
              </label>
              <input id="inquiry-subject" name="subject" maxlength="150" autocomplete="off" />
              <label class="label" for="inquiry-text">
                {account.inquiry.text}
              </label>
              <textarea id="inquiry-text" name="text" rows="5" maxlength="4000" required></textarea>
              <p class="field-error" role="alert" data-error></p>
              <p class="row">
                <button class="pill pill-inverse submit" type="submit">
                  {account.inquiry.send}
                </button>
                <span class="done mono" role="status" data-done></span>
              </p>
            </form>
          </section>

          <section class="card" aria-labelledby="contacts-title" data-contacts>
            <h2 class="card-title" id="contacts-title">
              {account.contacts.title}
            </h2>
            <p class="muted">{account.contacts.lead}</p>
            <ul class="list" data-contact-list></ul>
            <p class="muted" data-contacts-empty hidden>
              {account.contacts.empty}
            </p>
            <form class="fields add" data-contact-form novalidate>
              <label class="label" for="contact-kind">
                {account.contacts.kind}
              </label>
              <select id="contact-kind" name="kind">
                {kinds.map(([id, label]) => (
                  <option value={id}>{label}</option>
                ))}
              </select>
              <label class="label" for="contact-value">
                {account.contacts.value}
              </label>
              <input
                id="contact-value"
                name="value"
                maxlength="200"
                autocomplete="off"
                required
                placeholder={examples[kinds[0]?.[0] ?? 'phone']}
              />
              <p class="field-error" role="alert" data-error></p>
              <p class="row">
                <button class="pill pill-line submit" type="submit">
                  {account.contacts.add}
                </button>
              </p>
            </form>
          </section>
        </div>

        <div class="stack">
          <section class="card loyalty" aria-labelledby="loyalty-title" data-loyalty>
            <h2 class="card-title" id="loyalty-title">
              {account.loyalty.title}
            </h2>
            <div class="next">
              <p class="next-label mono muted">{account.loyalty.next}</p>
              <p class="percent mono" data-next-percent>
                —
              </p>
              <p class="muted" data-next-reason></p>
            </div>
            <dl class="facts">
              <div>
                <dt>{account.loyalty.level}</dt>
                <dd>
                  <span class="tier" data-tier></span>
                </dd>
              </div>
              <div>
                <dt>{account.loyalty.orders}</dt>
                <dd class="mono" data-orders>
                  0
                </dd>
              </div>
              <div>
                <dt>{account.loyalty.spent}</dt>
                <dd class="mono" data-spent></dd>
              </div>
            </dl>
            <div class="progress" data-progress hidden>
              <p data-progress-title></p>
              <i class="meter" aria-hidden="true">
                <b data-progress-bar></b>
              </i>
              <p class="mono muted" data-progress-left></p>
            </div>
            <p class="top" data-top hidden>
              {account.loyalty.top}
            </p>
            <p class="personal" data-personal hidden></p>
            <details class="rules">
              <summary>{account.loyalty.levels}</summary>
              <ol class="tiers">
                {loyalty.tiers.map((tier) => (
                  <li data-tier-id={tier.id}>
                    <span class="tier-name">{tier.name}</span>
                    <span class="mono muted">{rule(tier)}</span>
                    <span class="mono">−{tier.discount}%</span>
                  </li>
                ))}
              </ol>
              <p class="muted">
                {fill(account.loyalty.rules, { welcome: loyalty.welcome, eggs: loyalty.eggs })}
              </p>
            </details>
          </section>

          <section class="card" aria-labelledby="achievements-title" data-achievements-card>
            <h2 class="card-title" id="achievements-title">
              {account.eggs.title}
            </h2>
            <h3 class="subtitle mono">{account.orders.title}</h3>
            <ol class="achievements-list" data-orders>
              {ORDER_ACHIEVEMENTS.map((id) => (
                <li class:list={['achievement', { crown: id === 'all_orders' }]} data-order={id}>
                  <span class="achievement-icon" data-icon></span>
                  <span class="achievement-body">
                    <span class="achievement-name">{account.orders[id].name}</span>
                    <span class="achievement-text">
                      {fill(account.orders[id].text, { amount: money.format(loyalty.big_order) })}
                    </span>
                    <span class="achievement-state mono" data-state>
                      {account.orders.locked}
                    </span>
                  </span>
                  <span class="achievement-share mono" data-share></span>
                </li>
              ))}
            </ol>
            {panel && (
              <div class="eggs" data-eggs-card>
                <h3 class="subtitle mono">
                  {account.eggs.heading} · <span data-eggs-count>0/8</span>
                </h3>
                <div class="eggs-icons" aria-hidden="true" data-eggs-icons></div>
                <button class="pill pill-line cta" type="button" data-eggs-open>
                  {account.eggs.open}
                </button>
              </div>
            )}
          </section>

          <section class="card" aria-labelledby="profile-title">
            <h2 class="card-title" id="profile-title">
              {account.profile.title}
            </h2>
            <form class="fields" data-profile novalidate>
              <label class="label" for="profile-name">
                {account.profile.name}
              </label>
              <input id="profile-name" name="name" maxlength="100" autocomplete="name" />
              <label class="label" for="profile-company">
                {account.profile.company}
              </label>
              <input
                id="profile-company"
                name="company"
                maxlength="120"
                autocomplete="organization"
              />
              <label class="label" for="profile-lang">
                {account.profile.lang}
              </label>
              <select id="profile-lang" name="lang">
                <option value="en">English</option>
                <option value="uk">Українська</option>
                <option value="ru">Русский</option>
              </select>
              <fieldset class="choose">
                <legend class="label">{account.profile.preferred}</legend>
                <span class="methods">
                  <label class="method">
                    <input type="radio" name="preferred" value="email" />
                    <span>{account.profile.preferred_email}</span>
                  </label>
                  <label class="method">
                    <input type="radio" name="preferred" value="telegram" />
                    <span>{account.profile.preferred_telegram}</span>
                  </label>
                </span>
              </fieldset>
              <p class="row">
                <button class="pill pill-line submit" type="submit">
                  {account.profile.save}
                </button>
                <span class="done mono" role="status" data-done></span>
              </p>
            </form>
          </section>

          <section class="card" aria-labelledby="access-title" data-access>
            <h2 class="card-title" id="access-title">
              {account.access.title}
            </h2>
            <dl class="facts">
              <div>
                <dt>{account.access.email}</dt>
                <dd data-access-email></dd>
              </div>
              <div>
                <dt>{account.access.telegram}</dt>
                <dd data-access-telegram></dd>
              </div>
            </dl>
            <p class="row actions">
              <button class="link" type="button" data-email-change></button>
              <button class="link" type="button" data-telegram-link>
                {account.access.link_telegram}
              </button>
              <button class="link" type="button" data-telegram-unlink>
                {account.access.unlink}
              </button>
            </p>
            <form class="fields" data-access-email-form hidden novalidate>
              <label class="label" for="access-email">
                {account.login.email_label}
              </label>
              <input
                id="access-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                maxlength="200"
                required
              />
              <p class="row">
                <button class="pill pill-line submit" type="submit">
                  {account.login.send}
                </button>
                <button class="link" type="button" data-access-cancel>
                  {account.access.cancel}
                </button>
              </p>
            </form>
            <form class="fields" data-access-code-form hidden novalidate>
              <p class="sent" data-sent></p>
              <p class="row" data-access-bot hidden>
                <a
                  class="pill pill-inverse submit"
                  href={localePath(lang, 'account')}
                  target="_blank"
                  rel="noopener"
                  data-access-bot-link
                >
                  {account.login.telegram_open}
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </p>
              <label class="label" for="access-code">
                {account.login.code}
              </label>
              <input
                class="code mono"
                id="access-code"
                name="code"
                inputmode="numeric"
                autocomplete="one-time-code"
                pattern="[0-9]{6}"
                maxlength="6"
                required
              />
              <p class="row">
                <button class="pill pill-inverse submit" type="submit">
                  {account.login.submit}
                </button>
                <button class="link" type="button" data-access-cancel>
                  {account.access.cancel}
                </button>
              </p>
            </form>
            <p class="field-error" role="alert" data-error></p>
          </section>

          <section class="card" aria-labelledby="sessions-title" data-sessions>
            <h2 class="card-title" id="sessions-title">
              {account.sessions.title}
            </h2>
            <ul class="list" data-session-list></ul>
            <button class="link" type="button" data-sessions-end-all hidden>
              {account.sessions.end_all}
            </button>
          </section>

          <section class="card danger" aria-labelledby="delete-title">
            <h2 class="card-title" id="delete-title">
              {account.delete.title}
            </h2>
            <p class="muted">{account.delete.text}</p>
            <form class="fields" data-delete novalidate>
              <label class="consent">
                <input type="checkbox" name="confirm" data-delete-confirm />
                <span>{account.delete.confirm}</span>
              </label>
              <p class="row">
                <button class="pill pill-danger submit" type="submit" disabled data-delete-button>
                  {account.delete.button}
                </button>
              </p>
            </form>
          </section>
        </div>
      </div>
    </div>
  </div>

  {/* Rows the script clones: a request, a line of the conversation, a contact, a device. */}
  <template id="tpl-request">
    <li>
      <a class="request" href={localePath(lang, 'account')}>
        <span class="request-top">
          <span class="number mono" data-number></span>
          <span class="kind mono muted" data-kind></span>
          <span class="unread mono" data-unread hidden>
            {account.requests.unread}
          </span>
          <span class="pill-status" data-status></span>
        </span>
        <span class="request-title" data-title></span>
        <span class="excerpt muted" data-excerpt></span>
        <span class="request-bottom mono muted">
          <span data-date></span>
          <span data-discount></span>
        </span>
      </a>
    </li>
  </template>
  <template id="tpl-entry">
    <li class="entry">
      <p class="entry-head mono">
        <span data-who></span>
        <span class="muted" data-when></span>
      </p>
      <p class="entry-body" data-body></p>
    </li>
  </template>
  <template id="tpl-contact">
    <li class="row-item">
      <span class="item-main">
        <span class="mono muted" data-kind></span>
        <span data-value></span>
      </span>
      <button class="link" type="button" data-remove>
        {account.contacts.remove}
      </button>
    </li>
  </template>
  <template id="tpl-session">
    <li class="row-item">
      <span class="item-main">
        <span data-device></span>
        <span class="mono muted" data-seen></span>
      </span>
      <span class="current mono" data-current hidden>
        {account.sessions.current}
      </span>
      <button class="link" type="button" data-end>
        {account.sessions.end}
      </button>
    </li>
  </template>

  {panel && <Achievements data={data} account={false} />}
</Base>

<script>
  import { initAccount } from '../../scripts/account.ts';

  initAccount();
</script>

<style>
  .account {
    --amber: #e6b450;

    max-width: var(--page);
    width: 100%;
    margin: 0 auto;
    padding: 3.5rem var(--gutter) 6rem;
  }

  :global(:root[data-theme='light']) .account {
    --amber: #8a5a00;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .account {
      --amber: #8a5a00;
    }
  }

  .notice {
    max-width: 40rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-m);
    background: var(--surface);
  }

  [hidden] {
    display: none !important;
  }

  /* A status line in the manner of the site's service pages: «404 · ICMP TIME EXCEEDED». */
  .status,
  .loading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .status i,
  .loading i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: kro-blink 1.6s infinite;
  }

  .dashboard .status i {
    background: var(--ok);
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 500;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .lead {
    max-width: 36rem;
    color: var(--fg-2);
    text-wrap: pretty;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .label {
    padding: 0;
    font-size: 0.85rem;
    color: var(--fg-2);
  }

  .muted {
    color: var(--muted);
  }

  .link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg-2);
    font: inherit;
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .link:hover {
    color: var(--accent);
  }

  input[type='text'],

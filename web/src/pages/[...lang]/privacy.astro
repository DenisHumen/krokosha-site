---
// Privacy policy — required for analytics, the contact form and ads (brief A3, B5). The design
// (design/pages/privacy.dc.html): a side column with the way back, the date, the status of a draft
// and the contents; numbered sections with accent bullets.
import { render } from 'astro:content';
import { localeFromParam, localePath } from '../../i18n/locales.ts';
import Base from '../../layouts/Base.astro';
import { getPageData } from '../../lib/page-data.ts';
import { getTextPage, updatedDate } from '../../lib/pages.ts';
import { localeStaticPaths } from '../../lib/routes.ts';
import { breadcrumbsJsonLd } from '../../lib/seo.ts';

export const getStaticPaths = localeStaticPaths;

const lang = localeFromParam(Astro.params.lang);
const data = await getPageData(lang);
const entry = await getTextPage('privacy', lang);
const { Content, headings } = await render(entry);

const { title, status } = entry.data;
const updated = updatedDate(entry);
const contents = headings.filter((heading) => heading.depth === 2);
const origin = Astro.site ?? new URL(import.meta.env.SITE);
const breadcrumbs = breadcrumbsJsonLd(origin, lang, [
  { name: data.profile.nickname, page: '' },
  { name: title, page: 'privacy' },
]);
const description =
  entry.body
    ?.split(/\n\s*\n/)
    .map((block) => block.trim())
    .find((block) => block !== '' && !block.startsWith('#'))
    ?.replace(/[*_`]/g, '') ?? title;
---

<Base
  data={data}
  page="privacy"
  title={`${title} — ${data.profile.nickname}`}
  description={description}
  noindex={status === 'draft'}
  jsonLd={[breadcrumbs]}
>
  <div class="layout">
    <aside class="side mono">
      <a href={localePath(lang)}>← {data.site.not_found.back}</a>
      {updated && (
        <p>
          {data.site.projects.labels.updated}: <time datetime={updated}>{updated}</time>
        </p>
      )}
      {status === 'draft' && <p class="status">{data.site.ui.draft}</p>}
      {contents.length > 0 && (
        <nav class="contents" aria-label={data.site.ui.contents}>
          {contents.map((heading) => (
            <a href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      )}
    </aside>
    <article class="prose">
      <h1>{title}</h1>
      <Content />
    </article>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem 5rem;
    align-items: start;
    max-width: var(--page);
    margin: 0 auto;
    padding: 4rem var(--gutter) 6rem;
  }

  .side {
    display: grid;
    gap: 1rem;
    top: 5rem;
    font-size: 0.74rem;
    color: var(--muted);
  }

  .status {
    width: max-content;
    padding: 0.3rem 0.6rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-s);
  }

  .contents {
    display: grid;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .contents a {
    padding-left: 0.75rem;
    border-left: 1px solid var(--line);
  }

  .contents a:hover {
    border-color: var(--accent);
  }

  .prose {
    display: grid;
    gap: 1.1rem;
    max-width: 42rem;
    counter-reset: section;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 500;
    text-wrap: balance;
  }

  .prose :global(h2) {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 1.6rem;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    scroll-margin-top: 5rem;
    counter-increment: section;
  }

  /* 01, 02… before every section, in the accent colour. */
  .prose :global(h2)::before {
    content: counter(section, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
  }

  .prose :global(p) {
    color: var(--fg-2);
    text-wrap: pretty;
  }

  .prose :global(ul) {
    display: grid;
    gap: 0.4rem;
    padding-left: 0.2rem;
  }

  /* An accent dot instead of the bullet; the text of an item stays one flow (bold, code, links). */
  .prose :global(li) {
    position: relative;
    padding-left: 1.5rem;
    color: var(--fg-2);
  }

  .prose :global(li)::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.7rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .prose :global(strong) {
    font-weight: 500;
    color: var(--fg);
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .prose :global(code) {
    padding: 0.05em 0.35em;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  @media (min-width: 901px) {
    .layout {
      grid-template-columns: 14rem minmax(0, 1fr);
    }

    .side {
      position: sticky;
    }
  }
</style>

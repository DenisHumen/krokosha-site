---
// Base layout: <head> with full SEO (brief B7), the page frame of the design (design/pages/*.dc.html)
// and its four variants: the home page (fixed header, left rail, bottom bar on phones), a service
// page (404, privacy, thanks), the inverted /play, and an application with a frame of its own (the
// personal account, design v3): no header or footer of the site.
// data-slot / data-track / data-section attributes follow docs/contract.md.
import { Font } from 'astro:assets';
import '../../../design/tokens.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileBar from '../components/MobileBar.astro';
import Rail from '../components/Rail.astro';
import { OG_LOCALE, LOCALES, localePath } from '../i18n/locales.ts';
import type { SitePageData } from '../lib/page-data.ts';
import { absoluteUrl, alternateLinks, serializeJsonLd } from '../lib/seo.ts';

export type Variant = 'home' | 'page' | 'play' | 'app';

interface Props {
  data: SitePageData;
  /** Page path without the language prefix: '' for home, 'privacy'… */
  page: string;
  title: string;
  description: string;
  /** Service pages (404, play) and drafts are kept out of search results. */
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  variant?: Variant;
}

const {
  data,
  page,
  title,
  description,
  noindex = false,
  jsonLd = [],
  variant = 'page',
} = Astro.props;
const { lang, site, seo } = data;
const origin = Astro.site ?? new URL(import.meta.env.SITE);

const canonical = absoluteUrl(origin, localePath(lang, page));
const ogImage = absoluteUrl(origin, '/img/og-default.png');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {seo.verification.google && (
      <meta name="google-site-verification" content={seo.verification.google} />
    )}
    {seo.verification.bing && <meta name="msvalidate.01" content={seo.verification.bing} />}
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        {alternateLinks(origin, page).map(({ hreflang, href }) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))}
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={data.profile.nickname} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LOCALES.filter((code) => code !== lang).map((code) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[code]} />
    ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Google Search takes the 96 px one (a side that is a multiple of 48), browsers the SVG. */}
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#eeeeeb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <Font cssVariable="--font-geologica" />
    <Font cssVariable="--font-fira-code" />

    {/* Applies the saved theme before first paint. External and tiny on purpose: CSP stays free of inline scripts. */}
    <script is:inline src="/assets/theme.js"></script>
    {/* First-party statistics: readable source, no cookies, silent under Do Not Track (brief B5). */}
    <script is:inline defer src="/assets/analytics.js"></script>
    {jsonLd.map((block) => (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(block)}></script>
    ))}
  </head>
  <body class={`frame-${variant}`}>
    <a class="skip-link" href="#main">
      {site.ui.skip_to_content}
    </a>
    {variant !== 'app' && <Header data={data} page={page} variant={variant} />}
    {variant === 'home' && <Rail data={data} />}
    {variant === 'home' && <MobileBar data={data} />}
    <main id="main" class={`main-${variant}`}>
      <slot />
    </main>
    {variant !== 'app' && <Footer data={data} page={page} variant={variant} />}
  </body>
</html>

<style is:global>
  /* Service pages: header, content in the middle, footer at the bottom (design: 404, privacy, thanks). */
  .frame-page,
  .frame-play {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .frame-play {
    position: relative;
    overflow: hidden;
    background: var(--inverse-bg);
    color: var(--inverse-fg);
  }

  /* The home page leaves room for the fixed left rail on wide screens. */
  @media (min-width: 901px) {
    .main-home {
      padding-left: var(--rail-w);
    }
  }
</style>

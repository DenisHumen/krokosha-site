[Unit]
Description=krokosha site: API (analytics, admin, leads, bot)
Documentation=https://github.com/DenisHumen/krokosha-site/blob/main/api/README.md
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=krokosha
Group=krokosha
# adm: read access to nginx's access log for the «server traffic» dashboard
SupplementaryGroups=adm
EnvironmentFile=/etc/krokosha/env
ExecStart=/opt/krokosha/bin/krokosha-api
# The service waits for MySQL itself; if the database takes longer, systemd tries again.
Restart=always
RestartSec=3

MemoryHigh=200M
MemoryMax=300M

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=-/srv/krokosha/attachments
# The «rebuild now» button: the service drops a file here, krokosha-rebuild.path does the rest.
ReadWritePaths=-/var/lib/krokosha/requests
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target

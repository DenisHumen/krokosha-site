[Unit]
Description=krokosha site: GitHub sync, rebuild and release
Documentation=https://github.com/DenisHumen/krokosha-site/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=krokosha
Group=krokosha
EnvironmentFile=/etc/krokosha/env
Environment=HOME=/var/lib/krokosha
ExecStart=/opt/krokosha/repo/deploy/bin/build-release.sh
TimeoutStartSec=20min

# The build must never starve the rest of a small VPS.
Nice=10
IOSchedulingClass=idle
MemoryHigh=1G
MemoryMax=1400M

# The build runs third-party code (npm packages): give it as little of the system as possible.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
# npm and the site build run third-party code. They may write what the build makes and nothing
# that anything else runs: root runs deploy/ (backup, certificates, updates), the programs are built
# from api/ and the Go caches, git reads .git/ and ~/.gitconfig. Found by tracing a whole build:
# web/ (node_modules, dist, .astro), content/generated (the GitHub data), the npm and GitHub caches,
# status/ (the report, the lock), requests/ (the rebuild button), the releases.
ReadWritePaths=/opt/krokosha/repo/web /opt/krokosha/repo/content/generated
ReadWritePaths=/var/lib/krokosha/cache/npm /var/lib/krokosha/cache/github /var/lib/krokosha/status /var/lib/krokosha/requests
ReadWritePaths=/var/www/krokosha
# …and read nothing it has no business with: the mailbox requests (password hashes), the processes
# of other users, the files of requests (their place depends on --data-dir: install.sh adds it in
# krokosha-sync.service.d/data-dir.conf).
InaccessiblePaths=-/var/lib/krokosha/requests/mail -/var/lib/krokosha/mail
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0022

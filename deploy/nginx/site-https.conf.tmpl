# @@DOMAIN@@ — the site itself. Generated by deploy/install.sh; edit the template in the repository.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @@DOMAIN@@;

    ssl_certificate     @@TLS_CERT@@;
    ssl_certificate_key @@TLS_KEY@@;
    include snippets/krokosha-tls.conf;

    # `current` is a symlink that build-release.sh switches atomically to the newest release.
    root @@WWW@@/current;
    index index.html;
    charset utf-8;
    server_tokens off;
    absolute_redirect off;

    access_log /var/log/krokosha/nginx-access.json.log krokosha_json;
    error_log  /var/log/krokosha/nginx-error.log warn;

    include snippets/krokosha-compression.conf;
    include snippets/krokosha-headers.conf;

    # Build assets carry a content hash in the name: cache them for good.
    location ^~ /_astro/ {
        include snippets/krokosha-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Icons, the Open Graph picture, fonts: a week, revalidated afterwards.
    location ~* \.(?:png|jpe?g|gif|webp|avif|svg|ico|woff2?)$ {
        include snippets/krokosha-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    # The API: analytics events, the contact form.
    location /api/ {
        limit_req zone=krokosha_api burst=40 nodelay;
        limit_req_status 429;
        client_max_body_size 64k;
        include snippets/krokosha-proxy.conf;
    }

    # The map of the internet (docs/netmap.md): routes and networks. The addresses people trace
    # stay out of the log: only the path is written, without the query.
    location ^~ /api/net/ {
        limit_req zone=krokosha_api burst=40 nodelay;
        limit_req_status 429;
        client_max_body_size 1k;
        access_log /var/log/krokosha/nginx-access.json.log krokosha_json_path;
        include snippets/krokosha-proxy.conf;
    }

    # …and its data, rebuilt every night by krokosha-netmap.service. The overview is named by its
    # content and kept for good; the manifest that names it, only briefly. The overview is sent
    # gzipped as the sync wrote it, not compressed again for every visitor.
    location = /netmap/data/overview.json {
        alias @@WWW@@/netmap/overview.json;
        include snippets/krokosha-headers.conf;
        add_header Cache-Control "public, max-age=300" always;
    }

    location ^~ /netmap/data/ {
        alias @@WWW@@/netmap/;
        gzip_static on;
        include snippets/krokosha-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # The contact form. Files may come with it — up to 3 × 10 MB — when content/site.yaml allows
    # them (contacts.form.attachments). This is only the ceiling: the API reads 48 KB while files
    # are off, and checks the number, the size and the content of every file when they are on.
    location = /api/leads {
        limit_req zone=krokosha_form burst=20 nodelay;
        limit_req_status 429;
        limit_conn krokosha_uploads 2;
        limit_conn_status 429;
        client_max_body_size 32m;
        include snippets/krokosha-proxy.conf;
    }

    # Mail programs (Thunderbird and others) ask the site how to set up a mailbox of this domain.
    # The file is written by install.sh together with the mail server; without one — 404.
    location = /.well-known/autoconfig/mail/config-v1.1.xml {
        default_type application/xml;
        alias @@WWW@@/mail-autoconfig.xml;
    }

    # Telegram delivers the bot's updates here (brief B10.3): to an address that ends in a secret,
    # with a secret header — the API checks both. The address stays out of the access log (and so
    # out of the «server traffic» screen), and only Telegram's own networks get through
    # (core.telegram.org/bots/webhooks), plus this machine itself.
    location ^~ /api/telegram/ {
        access_log off;
        allow 149.154.160.0/20;
        allow 91.108.4.0/22;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        client_max_body_size 256k;
        include snippets/krokosha-proxy.conf;
    }

    # The admin area (brief B6): behind a secret path (ADMIN_PATH in /etc/krokosha/env) and over
    # HTTPS only — the plain-HTTP server never proxies it. Signing in is limited much harder than
    # the rest: every password check costs the server 64 MB and a good part of a second.
    location ^~ @@ADMIN_PATH@@/ {
        limit_req zone=krokosha_admin burst=40 nodelay;
        include snippets/krokosha-admin.conf;
    }

    location = @@ADMIN_PATH@@/login {
        limit_req zone=krokosha_login burst=10 nodelay;
        include snippets/krokosha-admin.conf;
    }

    location = @@ADMIN_PATH@@/login/code {
        limit_req zone=krokosha_login burst=10 nodelay;
        include snippets/krokosha-admin.conf;
    }

    location = @@ADMIN_PATH@@ {
        access_log /var/log/krokosha/nginx-admin.json.log krokosha_json;
        return 301 @@ADMIN_PATH@@/;
    }

    # Nothing hidden is ever served (the ACME challenge lives on port 80).
    location ~ /\. {
        return 404;
    }

    # Pages: always revalidated, so a new release is visible at once.
    # The «page not found» page speaks the language of the URL.
    location ^~ /uk/ {
        include snippets/krokosha-headers.conf;
        add_header Cache-Control "no-cache" always;
        error_page 404 /uk/404/index.html;
        try_files $uri $uri/ =404;
    }

    location ^~ /ru/ {
        include snippets/krokosha-headers.conf;
        add_header Cache-Control "no-cache" always;
        error_page 404 /ru/404/index.html;
        try_files $uri $uri/ =404;
    }

    location / {
        include snippets/krokosha-headers.conf;
        add_header Cache-Control "no-cache" always;
        error_page 404 /404/index.html;
        try_files $uri $uri/ =404;
    }
}

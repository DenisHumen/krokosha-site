# Plain HTTP. Used in two cases: before the first certificate exists (the site is reachable while
# Let's Encrypt validates the domain) and with `install.sh --tls none` (tests, a TLS proxy in front).

server {
    listen 80;
    listen [::]:80;
    server_name @@SERVER_NAMES@@;

    root @@WWW@@/current;
    index index.html;
    charset utf-8;
    server_tokens off;
    absolute_redirect off;

    access_log /var/log/krokosha/nginx-access.json.log krokosha_json;
    error_log  /var/log/krokosha/nginx-error.log warn;

    include snippets/krokosha-compression.conf;
    include snippets/krokosha-headers.conf;

    location ^~ /.well-known/acme-challenge/ {
        root @@WWW@@/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location ^~ /_astro/ {
        include snippets/krokosha-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The API: analytics events, the contact form. The admin area is NOT proxied here: it needs HTTPS
    # (its session cookie is Secure, and a password must never travel in clear text).
    location /api/ {
        limit_req zone=krokosha_api burst=40 nodelay;
        limit_req_status 429;
        client_max_body_size 64k;
        include snippets/krokosha-proxy.conf;
    }

    # The contact form. Files may come with it — up to 3 × 10 MB — when content/site.yaml allows
    # them (contacts.form.attachments). This is only the ceiling: the API reads 48 KB while files
    # are off, and checks the number, the size and the content of every file when they are on.
    location = /api/leads {
        limit_req zone=krokosha_form burst=20 nodelay;
        limit_req_status 429;
        limit_conn krokosha_uploads 2;
        limit_conn_status 429;
        client_max_body_size 32m;
        include snippets/krokosha-proxy.conf;
    }

    location ~ /\. {
        return 404;
    }

    location ^~ /uk/ {
        include snippets/krokosha-headers.conf;
        add_header Cache-Control "no-cache" always;
        error_page 404 /uk/404/index.html;
        try_files $uri $uri/ =404;
    }

    location ^~ /ru/ {
        include snippets/krokosha-headers.conf;
        add_header Cache-Control "no-cache" always;
        error_page 404 /ru/404/index.html;
        try_files $uri $uri/ =404;
    }

    location / {
        include snippets/krokosha-headers.conf;
        add_header Cache-Control "no-cache" always;
        error_page 404 /404/index.html;
        try_files $uri $uri/ =404;
    }
}

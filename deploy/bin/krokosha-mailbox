#!/usr/bin/env bash
# Mailboxes of the site's mail server.
#
#   sudo krokosha-mailbox list
#   sudo krokosha-mailbox add    ADDRESS     asks for the password (or: --password-stdin)
#   sudo krokosha-mailbox passwd ADDRESS
#   sudo krokosha-mailbox del    ADDRESS     the letters stay on disk until removed by hand
#   sudo krokosha-mailbox apply              what the «Почта» screen of the admin area asked for
#
# Mailboxes live in one file of the data root (docker-mailserver's postfix-accounts.cf); the mail
# server notices a change within seconds. A password is never an argument of any command: it
# would be visible to everybody on the machine for as long as the command runs.
#
# The admin area cannot touch that file and must not be able to: the web service drops a request
# into $KROKOSHA_STATE/requests/mail — the action, the address, the hash of the password — and
# krokosha-mailbox.path starts `krokosha-mailbox apply`, which checks every request again as if it
# came from a stranger. What it did, and the list of addresses (never the hashes), go to
# $KROKOSHA_STATE/mail, which the web service can read and not write.
set -euo pipefail

ENV_FILE=/etc/krokosha/env
[[ $EUID -eq 0 ]] || { echo "run with sudo" >&2; exit 1; }
[[ -r $ENV_FILE ]] || { echo "$ENV_FILE not found: is the site installed?" >&2; exit 1; }
data=$(sed -n 's/^KROKOSHA_DATA=//p' "$ENV_FILE" | tail -n 1)
domain=$(sed -n 's/^DOMAIN=//p' "$ENV_FILE" | tail -n 1)
state=$(sed -n 's/^KROKOSHA_STATE=//p' "$ENV_FILE" | tail -n 1)
state=${state:-/var/lib/krokosha}
site_user=$(sed -n 's/^KROKOSHA_USER=//p' "$ENV_FILE" | tail -n 1)
site_user=${site_user:-krokosha}
accounts=$data/mail/config/postfix-accounts.cf
requests=$state/requests/mail
status=$state/mail
[[ -f $accounts ]] || { echo "no mail server here (installed with --no-mail?)" >&2; exit 1; }

usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

command=${1:-}
address=${2:-}
address=${address,,}
from_stdin=no
[[ ${3:-} == --password-stdin ]] && from_stdin=yes

# --- the file of mailboxes -----------------------------------------------------------------------

is_address() { [[ $1 =~ ^[a-z0-9][a-z0-9._-]*@${domain//./\\.}$ && $1 != *..* && ${#1} -le 200 ]]; }
# The line of an address is found by its whole first field: an address is no pattern (as one, the
# dot of «l.ads@…» matches any character, and the line of «leads@…» would be taken for it).
exists() { awk -F'|' -v address="$1" '$1 == address { found = 1 } END { exit !found }' "$accounts"; }
without() { awk -F'|' -v address="$1" '$1 != address' "$accounts"; } # the file without that line

# write_hash ADDRESS SCHEME_AND_HASH — replaces or adds the line of the address.
write_hash() {
  local tmp
  tmp=$(mktemp "$accounts.XXXXXX")
  without "$1" >"$tmp"
  printf '%s|%s\n' "$1" "$2" >>"$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$accounts"
}

remove_line() {
  local tmp
  tmp=$(mktemp "$accounts.XXXXXX")
  without "$1" >"$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$accounts"
}

# publish: the list the admin area shows — addresses only. Written by rename into a directory that
# belongs to root: the site user can read it and cannot put anything in its place.
publish() {
  install -d -m 0750 -o root -g "$site_user" "$status"
  local tmp
  tmp=$(mktemp "$status/.mailboxes.XXXXXX")
  cut -d'|' -f1 "$accounts" | sort >"$tmp"
  chgrp "$site_user" "$tmp"
  chmod 0640 "$tmp"
  mv -f "$tmp" "$status/mailboxes"
}

# note ID ACTION ADDRESS ok|error MESSAGE — a line of the log the admin area reads; the last 50 stay.
note() {
  local tmp
  tmp=$(mktemp "$status/.log.XXXXXX")
  { tail -n 49 "$status/log" 2>/dev/null || true
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" "$4" "$5"
  } >"$tmp"
  chgrp "$site_user" "$tmp"
  chmod 0640 "$tmp"
  mv -f "$tmp" "$status/log"
}

# --- by hand ----------------------------------------------------------------------------------------

valid_address() {
  is_address "$address" || { echo "the address must be at $domain, e.g. denis@$domain" >&2; exit 1; }
}

read_password() { # → $password
  if [[ $from_stdin == yes ]]; then
    IFS= read -r password
  else
    [[ -t 0 ]] || { echo "no terminal to ask for a password: use --password-stdin" >&2; exit 1; }
    read -r -s -p "Password for $address (at least 12 characters): " password; echo >&2
    read -r -s -p "Once more: " again; echo >&2
    [[ $password == "$again" ]] || { echo "the two passwords differ" >&2; exit 1; }
  fi
  ((${#password} >= 12)) || { echo "the password must be at least 12 characters long" >&2; exit 1; }
}

hash_password() { printf '{SHA512-CRYPT}%s' "$(printf '%s' "$password" | openssl passwd -6 -stdin)"; }

# --- what the admin area asked for ------------------------------------------------------------------

# A hash the web service made (api/internal/mailboxes): SHA-512 crypt, nothing else.
# shellcheck disable=SC2016 # a regular expression: its dollars are literal
readonly hash_pattern='^\{SHA512-CRYPT\}\$6\$(rounds=[0-9]{4,9}\$)?[./0-9A-Za-z]{1,16}\$[./0-9A-Za-z]{86}$'

apply_one() { # FILE — never trusts it: the web service faces the internet
  local file=$1 name taken action='' target='' hash=''
  name=$(basename "$file" .req)
  # First out of the service's directory, by a rename (which never follows a link) into root's: the
  # file checked is the file read, and the service cannot swap it for a link to /etc/shadow between
  # the two.
  taken=$(mktemp -u "$status/.request.XXXXXXXX")
  mv -f -T -- "$file" "$taken" 2>/dev/null || return 0
  if [[ -L $taken || ! -f $taken || $(stat -c %U -- "$taken") != "$site_user" || ! $name =~ ^[0-9]{19}-[0-9a-f]{8}$ ]]; then
    rm -rf -- "$taken"
    return
  fi
  { IFS= read -r action; IFS= read -r target; IFS= read -r hash; } < <(head -c 1024 -- "$taken") || true
  rm -f -- "$taken"
  [[ $action =~ ^(add|passwd|del)$ ]] || action=-
  target=${target,,}
  if ! is_address "$target"; then
    note "$name" "$action" "-" error "не адрес домена $domain"
    return
  fi
  case $action in
    add)
      if exists "$target"; then note "$name" add "$target" error "ящик уже есть"; return; fi
      [[ $hash =~ $hash_pattern ]] || { note "$name" add "$target" error "неверный формат пароля"; return; }
      write_hash "$target" "$hash"
      note "$name" add "$target" ok "ящик создан"
      ;;
    passwd)
      [[ $target != "leads@$domain" ]] || { note "$name" passwd "$target" error "служебный ящик сайта: его пароль меняет установщик"; return; }
      exists "$target" || { note "$name" passwd "$target" error "такого ящика нет"; return; }
      [[ $hash =~ $hash_pattern ]] || { note "$name" passwd "$target" error "неверный формат пароля"; return; }
      write_hash "$target" "$hash"
      note "$name" passwd "$target" ok "пароль изменён"
      ;;
    del)
      [[ $target != "leads@$domain" ]] || { note "$name" del "$target" error "служебный ящик сайта нельзя удалить"; return; }
      exists "$target" || { note "$name" del "$target" error "такого ящика нет"; return; }
      remove_line "$target"
      note "$name" del "$target" ok "ящик удалён; письма остались на диске: $data/mail/data/$domain/${target%@*}"
      ;;
    *)
      note "$name" "-" "$target" error "неизвестное действие"
      ;;
  esac
}

# --- commands ---------------------------------------------------------------------------------------

case $command in
  list)
    cut -d'|' -f1 "$accounts"
    ;;
  add)
    valid_address
    ! exists "$address" || { echo "$address exists already; to change its password: krokosha-mailbox passwd $address" >&2; exit 1; }
    read_password
    write_hash "$address" "$(hash_password)"
    publish
    echo "$address created" >&2
    ;;
  passwd)
    valid_address
    exists "$address" || { echo "no such mailbox: $address" >&2; exit 1; }
    [[ $address != "leads@$domain" ]] || { echo "leads@$domain is the site's own mailbox: its password lives in $ENV_FILE and is managed by install.sh" >&2; exit 1; }
    read_password
    write_hash "$address" "$(hash_password)"
    publish
    echo "the password of $address is changed" >&2
    ;;
  del)
    valid_address
    exists "$address" || { echo "no such mailbox: $address" >&2; exit 1; }
    [[ $address != "leads@$domain" ]] || { echo "leads@$domain is the site's own mailbox: requests could neither be announced nor answered without it" >&2; exit 1; }
    remove_line "$address"
    publish
    echo "$address removed; its letters are still in $data/mail/data/$domain/${address%@*}" >&2
    ;;
  apply)
    install -d -m 0750 -o root -g "$site_user" "$status"
    shopt -s nullglob
    for file in "$requests"/*.req; do
      apply_one "$file"
    done
    publish
    ;;
  publish)
    publish
    ;;
  *) usage ;;
esac

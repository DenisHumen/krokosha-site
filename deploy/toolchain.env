# Build toolchain of the server, pinned. Only official tarballs are used, and every download is
# checked against the SHA-256 below before it is unpacked (brief B9: no `curl | bash`).
#
# To upgrade: take the new version and sums from
#   https://go.dev/dl/?mode=json
#   https://nodejs.org/dist/v<version>/SHASUMS256.txt   (node-v<version>-linux-{x64,arm64}.tar.xz)
# change the values here, and run deploy/update.sh on the server.

GO_VERSION=1.27.1
GO_SHA256_amd64=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445
GO_SHA256_arm64=3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec

# Same major version as web/.nvmrc (what CI builds with).
NODE_VERSION=24.21.0
NODE_SHA256_x64=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
NODE_SHA256_arm64=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2

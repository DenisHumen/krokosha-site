# /etc/krokosha/env — settings and secrets of an installed site.
# Owner root, mode 600. install.sh creates and maintains the file; this is only its description.
# systemd reads it for the services; the site build itself never sees these values
# (deploy/bin/build-release.sh starts npm with a clean environment).

# --- written by install.sh from its arguments ---
DOMAIN=example.com
ADMIN_EMAIL=admin@example.com
SITE_URL=https://example.com
# letsencrypt | selfsigned | none
TLS_MODE=letsencrypt
REPO_URL=https://github.com/DenisHumen/krokosha-site.git
REPO_BRANCH=main
# Extra firewall ports from --allow, space separated (WireGuard is detected automatically)
FIREWALL_ALLOW=
# yes = the operator passed --skip-firewall / --skip-dns-check; updates respect it
SKIP_FIREWALL=no
SKIP_DNS_CHECK=no

# --- secrets ---
# Optional. Fine-grained personal access token, «Public repositories (read-only)», no other
# permissions. Raises the GitHub API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

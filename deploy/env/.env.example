# /etc/krokosha/env — settings and secrets of an installed site.
# Owner root, mode 600. install.sh creates and maintains the file; this is only its description.
# systemd reads it for the services; the site build itself never sees these values
# (deploy/bin/build-release.sh starts npm with a clean environment).

# --- written by install.sh from its arguments ---
DOMAIN=example.com
ADMIN_EMAIL=admin@example.com
SITE_URL=https://example.com
# letsencrypt | selfsigned | none
TLS_MODE=letsencrypt
REPO_URL=https://github.com/DenisHumen/krokosha-site.git
REPO_BRANCH=main
# Extra firewall ports from --allow, space separated (WireGuard is detected automatically)
FIREWALL_ALLOW=
# yes = the operator passed --skip-firewall / --skip-dns-check; updates respect it
SKIP_FIREWALL=no
SKIP_DNS_CHECK=no

# Root of everything that must survive a move to another server (docs/architecture.md §6)
KROKOSHA_DATA=/srv/krokosha
KROKOSHA_CONTENT_DIR=/opt/krokosha/repo/content
# Optional, the defaults fit the layout made by install.sh:
# KROKOSHA_STATE=/var/lib/krokosha                                   caches, build report, rebuild requests
# KROKOSHA_WWW=/var/www/krokosha                                     releases of the site
# KROKOSHA_ACCESS_LOG=/var/log/krokosha/nginx-access.json.log        source of the «server traffic» screen
# Hidden prefix of the admin area, generated at installation
ADMIN_PATH=/_a1b2c3d4e5
MYSQL_ADDR=127.0.0.1:3306
MYSQL_DATABASE=krokosha
MYSQL_USER=krokosha

# --- secrets (generated by install.sh, never change them by hand) ---
MYSQL_PASSWORD=
REDIS_PASSWORD=
# Signs proof-of-work challenges of the contact form and, later, reply addresses of requests
APP_SECRET=
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0
# The MySQL root password lives apart, in /etc/krokosha/mysql-root.env: only the container needs it.

# --- outgoing mail: notifications about requests, confirmations to clients (brief B10) ---
# Filled in by install.sh together with the mail server. While SMTP_ADDR is empty, messages wait
# in the outbox — nothing is lost, the «system status» screen shows the queue.
SMTP_ADDR=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_NOTIFY_TO=
# The service mailbox, leads@<domain>: the envelope sender of everything the site sends, and — with
# the request's number signed into the address — where clients' answers come back (IMAP_*).
MAIL_INBOX=
IMAP_ADDR=
IMAP_USER=
IMAP_PASSWORD=
# Kept by install.sh: MAIL=yes|no (--no-mail is remembered), MAILBOX (the owner's mailbox),
# MAIL_NAME, MAIL_SERVICE_PASSWORD (the password of leads@, generated once), MAIL_HOST,
# MAIL_POSTMASTER, MAIL_TLS_DIR / MAIL_TLS_CERT / MAIL_TLS_KEY (where the mail container finds
# the site's certificate).

# --- the Telegram bot (brief B10.3) ---
# The token from @BotFather: set by install.sh (--telegram-token-file, or typed without echo),
# checked with Telegram, kept here and nowhere else. Empty — no bot; requests wait for it.
TELEGRAM_BOT_TOKEN=
# webhook: Telegram calls the site (needs HTTPS; the default). polling: the site asks Telegram —
# the fallback, works behind anything.
TELEGRAM_MODE=webhook
# TELEGRAM_API_URL=https://api.telegram.org      another Bot API server (self-hosted, tests)
# TELEGRAM_REMIND_MINUTES=30                     a new request nobody took for so long is pushed once more; 0 — never
# TELEGRAM_DIGEST_AT=09:00                       morning list of open requests, by the owner's clock
#                                                (content/site.yaml → timezone); off — never

# --- how long requests are kept (brief B10.7) ---
# Optional; the defaults are what the privacy page of the site promises. Change that page first.
# LEADS_KEEP_MONTHS=24        months without activity after which a request expires; 0 — never
# LEADS_EXPIRED=anonymize     anonymize: name, contact, texts and files go, the statistics stay;
#                             delete: the request goes completely
# LEADS_SPAM_DAYS=30          what the spam filter caught is deleted after so many days; 0 — never

# --- statistics (brief B5) ---
# Raw page views and events are removed after so many months; the sums of every day stay for
# good, and the dashboards of old periods are drawn from them. 0 — never removed.
# ANALYTICS_KEEP_MONTHS=12
# Countries and cities of visitors come from a MaxMind DB file that geoipupdate keeps fresh
# (install.sh --maxmind-account ID --maxmind-key-file FILE writes /etc/GeoIP.conf from these).
# Without the file everything works and the countries stay unknown; off — never looked up.
# GEOIP_DB=/var/lib/GeoIP/GeoLite2-City.mmdb
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=

# --- search engines (brief B7) ---
# IndexNow: after every release the pages that changed are submitted to Bing (and through its
# index DuckDuckGo and others), Yandex, Naver, Seznam. The key is generated once by install.sh
# and served by the site as /<key>.txt: no secret, only a proof that submissions are ours.
# INDEXNOW=yes                --no-indexnow is remembered here as no
# INDEXNOW_KEY=
# INDEXNOW_API=https://api.indexnow.org/indexnow     another endpoint (tests)

# --- backups (deploy/backup.sh, every night by krokosha-backup.timer) ---
# BACKUP_KEEP_DAILY=7         how many of the last daily backups stay
# BACKUP_KEEP_WEEKLY=4        …and how many Sunday ones after that
# BACKUP_RSYNC_TO=            user@host:/path — every backup is also copied there (rsync over SSH,
#                             root's key); without it the backups live on the same disk as the data

# --- secrets you provide ---
# Optional. Fine-grained personal access token, «Public repositories (read-only)», no other
# permissions. Raises the GitHub API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

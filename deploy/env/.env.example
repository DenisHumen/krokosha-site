# /etc/krokosha/env — settings and secrets of an installed site.
# Owner root, mode 600. install.sh creates and maintains the file; this is only its description.
# systemd reads it for the services; the site build itself never sees these values
# (deploy/bin/build-release.sh starts npm with a clean environment).

# --- written by install.sh from its arguments ---
DOMAIN=example.com
ADMIN_EMAIL=admin@example.com
SITE_URL=https://example.com
# letsencrypt | selfsigned | none
TLS_MODE=letsencrypt
REPO_URL=https://github.com/DenisHumen/krokosha-site.git
REPO_BRANCH=main
# Extra firewall ports from --allow, space separated (WireGuard is detected automatically)
FIREWALL_ALLOW=
# yes = the operator passed --skip-firewall / --skip-dns-check; updates respect it
SKIP_FIREWALL=no
SKIP_DNS_CHECK=no

# Root of everything that must survive a move to another server (docs/architecture.md §6)
KROKOSHA_DATA=/srv/krokosha
KROKOSHA_CONTENT_DIR=/opt/krokosha/repo/content
# Optional, the defaults fit the layout made by install.sh:
# KROKOSHA_STATE=/var/lib/krokosha                                   caches, build report, rebuild requests
# KROKOSHA_WWW=/var/www/krokosha                                     releases of the site
# KROKOSHA_ACCESS_LOG=/var/log/krokosha/nginx-access.json.log        source of the «server traffic» screen
# Hidden prefix of the admin area, generated at installation
ADMIN_PATH=/_a1b2c3d4e5
MYSQL_ADDR=127.0.0.1:3306
MYSQL_DATABASE=krokosha
MYSQL_USER=krokosha

# --- secrets (generated by install.sh, never change them by hand) ---
MYSQL_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0
# The MySQL root password lives apart, in /etc/krokosha/mysql-root.env: only the container needs it.

# --- secrets you provide ---
# Optional. Fine-grained personal access token, «Public repositories (read-only)», no other
# permissions. Raises the GitHub API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

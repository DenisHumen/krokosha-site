# Normalize line endings: the project is edited on Windows but runs on Linux.
* text=auto eol=lf

*.sh      text eol=lf
*.bash    text eol=lf
*.ps1     text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.mp4   binary
*.webm  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.riv   binary
*.pdf   binary
*.zip   binary
